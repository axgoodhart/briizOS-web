{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/ipod",
        "destination": "/apps/iPodAlex.html"
      },
      {
        "source": "/ipod/**",
        "destination": "/apps/iPodAlex.html"
      },
      {
        "source": "/zynth",
        "destination": "/apps/zynth/build/index.html"
      },
      {
        "source": "/zynth/**",
        "destination": "/apps/zynth/build/index.html"
      }
    ]
  }
}
