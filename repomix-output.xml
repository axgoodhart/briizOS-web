      function start(){ if(st.running) return; if(st.mode==='timer'){ if(st.remaining<=0) st.remaining=st.defaultTimer; st.startTime=Date.now(); st.endTime=st.startTime+st.remaining; } else { st.startTime=Date.now()-st.elapsed; } acknowledgeAlarm(); if(st.mode==='timer'){ playAlarmStart(); } st.running=true; st.paused=false; tick(); setStatus('running'); toSmall(); save(); }
      function pauseToggle(){ if(!st.running) return; if(!st.paused){ cancelAnimationFrame(st.tickId); st.tickId=0; if(st.mode==='timer'){ st.remaining=Math.max(0, st.endTime-Date.now()); } else { st.elapsed=Date.now()-st.startTime; } st.paused=true; setStatus('paused'); } else { if(st.mode==='timer'){ st.startTime=Date.now(); st.endTime=st.startTime+st.remaining; } else { st.startTime=Date.now()-st.elapsed; } st.paused=false; setStatus('running'); tick(); } refresh(); save(); }
      function stopReset(){ acknowledgeAlarm(); cancelAnimationFrame(st.tickId); st.tickId=0; st.running=false; st.paused=false; if(st.mode==='timer'){ st.remaining=st.defaultTimer; el.progress.style.transform='scaleX(0)'; el.time.textContent=fmt(st.remaining); } else { st.elapsed=0; el.time.textContent=fmt(0); } setStatus('idle'); toBig(); refresh(); save(); }
      function addTime(ms){ if(st.mode!=='timer') return; if(st.running && !st.paused){ st.endTime += ms; if(st.endTime < Date.now()) st.endTime = Date.now(); } else { st.remaining = Math.max(0, (st.remaining||st.defaultTimer) + ms); el.time.textContent = fmt(st.remaining); } st.defaultTimer = st.remaining || st.defaultTimer; refresh(); save(); }
