    let wantsReminderEvent = false;
    const tagSel = document.getElementById('org-tag');
    const chatWrap = document.getElementById('org-chat-controls');
    const chatModel = document.getElementById('org-chat-model');
    const externalWrap = document.getElementById('org-external-controls');
    const externalUrl = document.getElementById('org-external-url');

    // Time fields for events
    const timeFieldsWrap = document.getElementById('org-time-fields');
    const timeStartInput = document.getElementById('org-time-start');
    const durationInput = document.getElementById('org-duration');

    const providers = {
      openai: ['gpt-4o-mini', 'gpt-4o'],
      claude: ['claude-3-5-sonnet', 'claude-3-5-haiku'],
      gemini: ['gemini-1.5-pro', 'gemini-1.5-flash']
    };
    let selectedProvider = null;

    const reminderPrompt = document.getElementById('org-reminder-prompt');
    const reminderButtons = reminderPrompt ? Array.from(reminderPrompt.querySelectorAll('button[data-choice]')) : [];

    const recurrenceWrap = document.getElementById('org-recurring-wrap');
    const recurrenceBtn = document.getElementById('org-event-recurring-btn');
    const recurrencePanel = document.getElementById('org-event-recurring-panel');
    const recurrenceTypeSelect = document.getElementById('org-event-recurring-type');
    const recurrenceIntervalRow = document.getElementById('org-event-recurring-interval-row');
    const recurrenceIntervalSelect = document.getElementById('org-event-recurring-interval');
    const recurrenceDaysContainer = document.getElementById('org-event-recurring-days');
    const recurrenceDayButtons = recurrenceDaysContainer ? Array.from(recurrenceDaysContainer.querySelectorAll('button[data-day]')) : [];
    let recurrenceEnabled = false;
    let recurrenceDaysTouched = false;
    let selectedRecurrenceDays = new Set();

    const todayIso = () => yyyyMMdd(new Date());
    const resetDateFieldToToday = () => { if (date) date.value = todayIso(); };
    const ensureDateValue = () => { if (date && !date.value) date.value = todayIso(); };
    resetDateFieldToToday();

    const hideReminderPrompt = () => {
      if (!reminderPrompt) return;
      reminderPrompt.classList.remove('show');
      reminderButtons.forEach(btn => btn.classList.remove('active'));
    };
    const showReminderPrompt = () => {
      if (!reminderPrompt) return;
      reminderPrompt.classList.add('show');
    };
    const setReminderChoice = (choice) => {
      if (!choice) return;
      wantsReminderEvent = choice === 'yes';
      reminderButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.choice === choice));
    };
    if (reminderButtons.length) {
      reminderButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const choice = btn.dataset.choice;
          setReminderChoice(choice);
        });
      });
    }

    const getAnchorDate = () => {
      if (date && date.value) return parseYMDLocal(date.value);
      return new Date();
    };
    const anchorDayOfWeek = () => getAnchorDate().getDay();
    const syncRecurrenceDayButtons = () => {
      if (!recurrenceDayButtons.length) return;
      recurrenceDayButtons.forEach(btn => {
        const day = Number(btn.dataset.day);
        btn.classList.toggle('active', selectedRecurrenceDays.has(day));
      });
    };
    const resetRecurrenceDaysToAnchor = () => {
      selectedRecurrenceDays = new Set([anchorDayOfWeek()]);
      recurrenceDaysTouched = false;
      syncRecurrenceDayButtons();
    };
    const syncIntervalLabels = () => {
      if (!recurrenceIntervalSelect) return;
      const typeVal = recurrenceTypeSelect?.value || 'weekly';
      Array.from(recurrenceIntervalSelect.options).forEach(opt => {
        const base = parseInt(opt.value, 10);
        if (typeVal === 'monthly') {
          opt.textContent = base === 1 ? 'Every month' : `Every ${base} months`;
        } else {
          opt.textContent = base === 1 ? 'Every week' : `Every ${base} weeks`;
        }
      });
    };
    const syncRecurrenceVisibility = () => {
      if (!recurrenceWrap) return;
      const typeVal = recurrenceTypeSelect?.value || 'weekly';
      const showInterval = typeVal !== 'monthly';
      const showDays = typeVal !== 'monthly';
      if (recurrenceIntervalRow) {
        recurrenceIntervalRow.classList.toggle('show', showInterval);
      }
      if (recurrenceDaysContainer) {
        recurrenceDaysContainer.classList.toggle('show', showDays);
      }
      syncRecurrenceDayButtons();
      syncIntervalLabels();
      if (typeVal === 'weekly' && selectedRecurrenceDays.size !== 1) {
        resetRecurrenceDaysToAnchor();
      }
      if ((typeVal === 'custom' || typeVal === 'weekly') && selectedRecurrenceDays.size === 0) {
        resetRecurrenceDaysToAnchor();
      }
    };
    const setRecurrenceEnabled = (flag) => {
      recurrenceEnabled = flag;
      if (recurrenceBtn) recurrenceBtn.classList.toggle('active', recurrenceEnabled);
      if (recurrencePanel) recurrencePanel.classList.toggle('show', recurrenceEnabled);
      if (recurrenceEnabled) {
        if (selectedRecurrenceDays.size === 0) resetRecurrenceDaysToAnchor();
        syncRecurrenceVisibility();
      }
    };

    const syncDateModeButtons = () => {
      if (!dateModeButtons.length) return;
      dateModeButtons.forEach(btn => {
        const isActive = btn.dataset.mode === dateMode;
        btn.classList.toggle('active', isActive);
      });
    };

    const setDateMode = (mode, { prompt = false, resetReminder = false } = {}) => {
      if (!mode) return;
      dateMode = mode;
      syncDateModeButtons();
      if (mode === 'due') {
        if (resetReminder) {
          wantsReminderEvent = false;
          hideReminderPrompt();
        }
        if (prompt && type.value !== 'event') {
          showReminderPrompt();
          setReminderChoice('no');
        }
      } else {
        wantsReminderEvent = false;
        hideReminderPrompt();
      }
    };

    if (dateModeButtons.length) {
      setDateMode('created', { resetReminder: true });
      dateModeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.mode;
          setDateMode(mode, { prompt: mode === 'due', resetReminder: true });
        });
      });
    }

    if (recurrenceBtn) {
      recurrenceBtn.addEventListener('click', () => {
        setRecurrenceEnabled(!recurrenceEnabled);
      });
    }
    if (recurrenceTypeSelect) {
      recurrenceTypeSelect.addEventListener('change', () => {
        if (!recurrenceEnabled) return;
        syncRecurrenceVisibility();
      });
    }
    if (recurrenceDayButtons.length) {
      recurrenceDayButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          if (!recurrenceEnabled) return;
          const day = Number(btn.dataset.day);
          const typeVal = recurrenceTypeSelect?.value || 'weekly';
          if (typeVal === 'weekly') {
            selectedRecurrenceDays = new Set([day]);
          } else {
            if (selectedRecurrenceDays.has(day)) selectedRecurrenceDays.delete(day);
            else selectedRecurrenceDays.add(day);
            if (selectedRecurrenceDays.size === 0) selectedRecurrenceDays.add(day);
          }
          recurrenceDaysTouched = true;
          syncRecurrenceDayButtons();
        });
      });
    }
    if (recurrenceIntervalSelect) {
      syncIntervalLabels();
    }

    setRecurrenceEnabled(false);

    const refreshAddEnabled = () => {
      const t = type.value;
      const hasTitle = !!name.value.trim();
      if (t === 'chat') {
        addBtn.disabled = !(hasTitle && selectedProvider);
      } else if (t === 'event') {
        addBtn.disabled = !(hasTitle && !!date.value);
      } else if (t === 'external') {
        const hasUrl = !!externalUrl.value.trim();
        addBtn.disabled = !(hasTitle && hasUrl);
      } else {
        addBtn.disabled = !hasTitle;
      }
    };

    const handleDateFieldChange = () => {
