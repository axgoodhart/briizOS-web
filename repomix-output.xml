      return d;
    },
  };

  const calendarAdapter = {
    normalizeOnRead(id, data) {
      return {
        id: String(id),
        type: data.type || 'event',
        title: data.title || data.text || data.name || '',
        body: data.body || data.description || '',
        scheduledDate: data.scheduledDate || (typeof data.date === 'string' ? data.date : null) || data.dateValue || null,
        status: (data.completed || data.completedAt) ? 'done' : (data.status || 'todo'),
        completed: !!(data.completed || data.completedAt),
        completedAt: data.completedAt || null,
        time: data.time || null,
        start: data.start ?? data.startMinute ?? null,
        end: data.end ?? null,
        durationMinutes: data.durationMinutes ?? data.duration ?? null,
        allDay: data.allDay || false,
        color: data.color || '#3b82f6',
        createdAt: data.createdAt || Date.now(),
        updatedAt: data.updatedAt || Date.now(),
      };
    },
    prepareForWrite(d, isNew = false) {
      strId(d);
      stamp(d, isNew);
      if (!d.title && (d.text || d.name)) d.title = d.text || d.name;
      if (!d.body && d.description) d.body = d.description;
      if (!d.scheduledDate && d.date) {
        if (d.date instanceof Date) {
          const dt = d.date;
          d.scheduledDate = dt.getFullYear() + '-' + String(dt.getMonth()+1).padStart(2,'0') + '-' + String(dt.getDate()).padStart(2,'0');
        } else {
          d.scheduledDate = d.date;
        }
      }
      delete d.text; delete d.name; delete d.date; delete d.dateValue; delete d.description;
      if (d.type === undefined) d.type = 'event';
      if (d.status === undefined) d.status = 'todo';
      requireFields(d, ['id','type','title','scheduledDate','status','createdAt'], 'calendarAdapter');
      return d;
    },
  };

  const noteAdapter = {
    normalizeOnRead(id, data) {
      // Resolve Web UI position: prefer nested ui.web.xywh, fallback to flat fields
      const webUI = data.ui?.web?.xywh;
      const x = webUI?.x ?? data.x ?? 0;
      const y = webUI?.y ?? data.y ?? 0;
      const w = webUI?.w ?? data.w ?? undefined;
      const h = webUI?.h ?? data.h ?? undefined;
      return {
        id: String(id),
        type: data.type || 'note',
        title: data.title || '',
        body: data.body || data.content || '',
        customColor: data.customColor || null,
        x, y, w, h,
        active: data.active !== false,
        isDocked: data.isDocked !== false,
        tags: Array.isArray(data.tags) ? data.tags : [],
        createdAt: data.createdAt || Date.now(),
        updatedAt: data.updatedAt || Date.now(),
        // pass through extra panel fields
        orgId: data.orgId || null,
        chat: data.chat || null,
        externalUrl: data.externalUrl || '',
        externalShowUrl: !!data.externalShowUrl,
        externalData: data.externalData || null,
        subtype: data.subtype || null,
        autoHeight: data.autoHeight !== false,
        expansionCount: data.expansionCount || 0,
        jobMessage: data.jobMessage || null,
        taskId: data.taskId || null,
      };
    },
    prepareForWrite(d, isNew = false) {
      strId(d);
      stamp(d, isNew);
      // Canonical key: body not content
      if (d.content !== undefined && d.body === undefined) d.body = d.content;
      delete d.content;
      // Move flat position fields into ui.web.xywh
      const x = d.x, y = d.y, w = d.w, h = d.h;
      if (x !== undefined || y !== undefined || w !== undefined || h !== undefined) {
        if (!d.ui) d.ui = {};
        if (!d.ui.web) d.ui.web = {};
        d.ui.web.xywh = {
          x: Number(x) || 0,
          y: Number(y) || 0,
          w: Number.isFinite(Number(w)) && Number(w) > 0 ? Number(w) : 300,
          h: Number.isFinite(Number(h)) && Number(h) > 0 ? Number(h) : undefined,
        };
        // Clean undefined from xywh
        if (d.ui.web.xywh.h === undefined) delete d.ui.web.xywh.h;
      }
      // Remove flat position fields — prohibited by contract §9
      delete d.x; delete d.y; delete d.w; delete d.h;
      if (d.body === undefined) d.body = '';
      if (d.customColor === undefined) d.customColor = null;
      requireFields(d, ['id','type','title','createdAt'], 'noteAdapter');
      return d;
    },
  };

  return { taskAdapter, organizerAdapter, calendarAdapter, noteAdapter };
})();
// ── End Sync Adapters ────────────────────────────────────────────

const form = document.getElementById("auth-form");
