              <aside class="job-details" id="job-details-${panel.id}">
                <div class="job-details-header">Task ID #<span class="job-id-display">${(panel.taskId || panel.id).replace('tasks-', '')}</span></div>
                <div class="job-details-content">
                  <div class="job-details-label">User:</div>
                  <div class="job-details-value">${panel.jobMessage || ''}</div>
                  <div class="job-details-label">Task.md:</div>
                  <div class="job-details-value job-task-md-status" style="color: #ff2a6d; font-style: italic;">not found</div>
                  <div class="job-details-label">Actions:</div>
