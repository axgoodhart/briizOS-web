  // Draggable calendar panel (overlay)
  let calPanelDragBound = false;
  function initCalPanelDrag(){
    if (calPanelDragBound) return;
    const wrap = document.getElementById('cal-drag-wrap');
    const panel = document.getElementById('cal-panel');
    const header = panel?.querySelector('.cal-header') || panel;
    const handle = document.getElementById('cal-drag-handle');
    if (!wrap || !panel) return;
    let startX=0, startY=0, startLeft=0, startTop=0;
    const clampPosition = (left, top)=>{
      const w = wrap.offsetWidth;
      const h = wrap.offsetHeight;
      const nx = Math.max(8, Math.min(window.innerWidth - w - 8, left));
      const ny = Math.max(8, Math.min(window.innerHeight - h - 8, top));
      wrap.style.left = nx + 'px';
      wrap.style.top = ny + 'px';
      wrap.style.right = 'auto';
      wrap.style.bottom = 'auto';
      wrap._dragLeft = nx;
      wrap._dragTop = ny;
    };
    wrap._setCalendarPosition = clampPosition;
    wrap._nudgeCalendar = (dx, dy)=>{
      const rect = wrap.getBoundingClientRect();
      clampPosition(rect.left + dx, rect.top + dy);
    };
    const onDown = (e)=>{
      wrap.classList.add('dragging');
      startX = e.clientX; startY = e.clientY;
      const rect = wrap.getBoundingClientRect();
      startLeft = rect.left; startTop = rect.top;
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
      e.preventDefault();
    };
    const onMove = (e)=>{
      const dx = e.clientX - startX; const dy = e.clientY - startY;
      clampPosition(startLeft + dx, startTop + dy);
    };
    const onUp = ()=>{
      wrap.classList.remove('dragging');
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
    };
    // Header drag when not in lay mode
    header.addEventListener('mousedown', (e)=>{
      if (wrap.classList.contains('lay')) return;
      onDown(e);
    });
    // Handle drag when in lay mode
    if (handle) {
      handle.addEventListener('mousedown', (e)=>{
        if (!wrap.classList.contains('lay')) return;
        e.stopPropagation();
        onDown(e);
      });
    }
    calPanelDragBound = true;
  }

