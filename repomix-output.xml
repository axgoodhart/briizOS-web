    if (!wrap) return; wrap.classList.remove('show'); wrap.setAttribute('aria-hidden','true');
  }
  document.addEventListener('DOMContentLoaded', () => {
    const addBtn = document.getElementById('org-add');
    const name = document.getElementById('org-name');
    const type = document.getElementById('org-type');
    const date = document.getElementById('org-date');
    const dateFieldWrap = document.getElementById('org-date-field');
    const dateModeWrap = document.getElementById('org-date-mode');
    const dateModeButtons = dateModeWrap ? Array.from(dateModeWrap.querySelectorAll('.org-date-toggle')) : [];
    let dateMode = 'created';
    let wantsReminderEvent = false;
    const tagSel = document.getElementById('org-tag');
    const chatWrap = document.getElementById('org-chat-controls');
    const chatModel = document.getElementById('org-chat-model');
    const externalWrap = document.getElementById('org-external-controls');
    const externalUrl = document.getElementById('org-external-url');

    // Time fields for events
    const timeFieldsWrap = document.getElementById('org-time-fields');
    const timeStartInput = document.getElementById('org-time-start');
    const durationInput = document.getElementById('org-duration');

    const providers = {
      openai: ['gpt-4o-mini', 'gpt-4o'],
      claude: ['claude-3-5-sonnet', 'claude-3-5-haiku'],
      gemini: ['gemini-1.5-pro', 'gemini-1.5-flash']
    };
    let selectedProvider = null;

    const reminderPrompt = document.getElementById('org-reminder-prompt');
    const reminderButtons = reminderPrompt ? Array.from(reminderPrompt.querySelectorAll('button[data-choice]')) : [];

    const recurrenceWrap = document.getElementById('org-recurring-wrap');
    const recurrenceBtn = document.getElementById('org-event-recurring-btn');
    const recurrencePanel = document.getElementById('org-event-recurring-panel');
    const recurrenceTypeSelect = document.getElementById('org-event-recurring-type');
    const recurrenceIntervalRow = document.getElementById('org-event-recurring-interval-row');
    const recurrenceIntervalSelect = document.getElementById('org-event-recurring-interval');
    const recurrenceDaysContainer = document.getElementById('org-event-recurring-days');
    const recurrenceDayButtons = recurrenceDaysContainer ? Array.from(recurrenceDaysContainer.querySelectorAll('button[data-day]')) : [];
    let recurrenceEnabled = false;
    let recurrenceDaysTouched = false;
    let selectedRecurrenceDays = new Set();

    const todayIso = () => yyyyMMdd(new Date());
    const resetDateFieldToToday = () => { if (date) date.value = todayIso(); };
    const ensureDateValue = () => { if (date && !date.value) date.value = todayIso(); };
    resetDateFieldToToday();

    const hideReminderPrompt = () => {
      if (!reminderPrompt) return;
      reminderPrompt.classList.remove('show');
      reminderButtons.forEach(btn => btn.classList.remove('active'));
    };
    const showReminderPrompt = () => {
      if (!reminderPrompt) return;
      reminderPrompt.classList.add('show');
    };
    const setReminderChoice = (choice) => {
      if (!choice) return;
      wantsReminderEvent = choice === 'yes';
      reminderButtons.forEach(btn => btn.classList.toggle('active', btn.dataset.choice === choice));
    };
    if (reminderButtons.length) {
      reminderButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const choice = btn.dataset.choice;
          setReminderChoice(choice);
        });
      });
    }

    const getAnchorDate = () => {
      if (date && date.value) return parseYMDLocal(date.value);
      return new Date();
    };
    const anchorDayOfWeek = () => getAnchorDate().getDay();
    const syncRecurrenceDayButtons = () => {
      if (!recurrenceDayButtons.length) return;
      recurrenceDayButtons.forEach(btn => {
        const day = Number(btn.dataset.day);
        btn.classList.toggle('active', selectedRecurrenceDays.has(day));
      });
    };
    const resetRecurrenceDaysToAnchor = () => {
      selectedRecurrenceDays = new Set([anchorDayOfWeek()]);
      recurrenceDaysTouched = false;
      syncRecurrenceDayButtons();
    };
    const syncIntervalLabels = () => {
      if (!recurrenceIntervalSelect) return;
      const typeVal = recurrenceTypeSelect?.value || 'weekly';
      Array.from(recurrenceIntervalSelect.options).forEach(opt => {
        const base = parseInt(opt.value, 10);
        if (typeVal === 'monthly') {
          opt.textContent = base === 1 ? 'Every month' : `Every ${base} months`;
        } else {
          opt.textContent = base === 1 ? 'Every week' : `Every ${base} weeks`;
        }
      });
    };
    const syncRecurrenceVisibility = () => {
      if (!recurrenceWrap) return;
      const typeVal = recurrenceTypeSelect?.value || 'weekly';
      const showInterval = typeVal !== 'monthly';
      const showDays = typeVal !== 'monthly';
      if (recurrenceIntervalRow) {
        recurrenceIntervalRow.classList.toggle('show', showInterval);
      }
      if (recurrenceDaysContainer) {
        recurrenceDaysContainer.classList.toggle('show', showDays);
      }
      syncRecurrenceDayButtons();
      syncIntervalLabels();
      if (typeVal === 'weekly' && selectedRecurrenceDays.size !== 1) {
        resetRecurrenceDaysToAnchor();
      }
      if ((typeVal === 'custom' || typeVal === 'weekly') && selectedRecurrenceDays.size === 0) {
        resetRecurrenceDaysToAnchor();
      }
    };
    const setRecurrenceEnabled = (flag) => {
      recurrenceEnabled = flag;
      if (recurrenceBtn) recurrenceBtn.classList.toggle('active', recurrenceEnabled);
      if (recurrencePanel) recurrencePanel.classList.toggle('show', recurrenceEnabled);
      if (recurrenceEnabled) {
        if (selectedRecurrenceDays.size === 0) resetRecurrenceDaysToAnchor();
        syncRecurrenceVisibility();
      }
    };

    const syncDateModeButtons = () => {
      if (!dateModeButtons.length) return;
      dateModeButtons.forEach(btn => {
        const isActive = btn.dataset.mode === dateMode;
        btn.classList.toggle('active', isActive);
      });
    };

    const setDateMode = (mode, { prompt = false, resetReminder = false } = {}) => {
      if (!mode) return;
      dateMode = mode;
      syncDateModeButtons();
      if (mode === 'due') {
        if (resetReminder) {
          wantsReminderEvent = false;
          hideReminderPrompt();
        }
        if (prompt && type.value !== 'event') {
          showReminderPrompt();
          setReminderChoice('no');
        }
      } else {
        wantsReminderEvent = false;
        hideReminderPrompt();
      }
    };

    if (dateModeButtons.length) {
      setDateMode('created', { resetReminder: true });
      dateModeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.mode;
          setDateMode(mode, { prompt: mode === 'due', resetReminder: true });
        });
      });
    }

    if (recurrenceBtn) {
      recurrenceBtn.addEventListener('click', () => {
        setRecurrenceEnabled(!recurrenceEnabled);
      });
    }
    if (recurrenceTypeSelect) {
      recurrenceTypeSelect.addEventListener('change', () => {
        if (!recurrenceEnabled) return;
        syncRecurrenceVisibility();
      });
    }
    if (recurrenceDayButtons.length) {
      recurrenceDayButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          if (!recurrenceEnabled) return;
          const day = Number(btn.dataset.day);
          const typeVal = recurrenceTypeSelect?.value || 'weekly';
          if (typeVal === 'weekly') {
            selectedRecurrenceDays = new Set([day]);
          } else {
            if (selectedRecurrenceDays.has(day)) selectedRecurrenceDays.delete(day);
            else selectedRecurrenceDays.add(day);
            if (selectedRecurrenceDays.size === 0) selectedRecurrenceDays.add(day);
          }
          recurrenceDaysTouched = true;
          syncRecurrenceDayButtons();
        });
      });
    }
    if (recurrenceIntervalSelect) {
      syncIntervalLabels();
    }

    setRecurrenceEnabled(false);

    const refreshAddEnabled = () => {
      const t = type.value;
      const hasTitle = !!name.value.trim();
      if (t === 'chat') {
        addBtn.disabled = !(hasTitle && selectedProvider);
      } else if (t === 'event') {
        addBtn.disabled = !(hasTitle && !!date.value);
      } else if (t === 'external') {
        const hasUrl = !!externalUrl.value.trim();
        addBtn.disabled = !(hasTitle && hasUrl);
      } else {
        addBtn.disabled = !hasTitle;
      }
    };

    const handleDateFieldChange = () => {
      refreshAddEnabled();
      if (type.value === 'event') {
        if (!recurrenceDaysTouched || selectedRecurrenceDays.size === 0) {
          resetRecurrenceDaysToAnchor();
        }
        if (recurrenceEnabled) {
          syncRecurrenceVisibility();
        }
      }
    };

    type.addEventListener('change', () => {
      selectedProvider = null;
      document.querySelectorAll('.chat-prov').forEach(b=> b.classList.remove('active'));
      chatModel.style.display = 'none';
      chatModel.innerHTML = '';

      chatWrap.style.display = 'none';
      externalWrap.style.display = 'none';

      const currentType = type.value;
      const supportsDate = currentType !== 'chat' && currentType !== 'external';

      if (dateFieldWrap) dateFieldWrap.style.display = supportsDate ? '' : 'none';
      if (dateModeWrap) {
        dateModeWrap.style.display = supportsDate && currentType !== 'event' ? 'flex' : 'none';
      }

      // Show/hide time fields for events
      if (timeFieldsWrap) {
        timeFieldsWrap.style.display = currentType === 'event' ? 'flex' : 'none';
      }

      if (currentType === 'chat') {
        chatWrap.style.display = 'flex';
      } else if (currentType === 'external') {
        externalWrap.style.display = 'flex';
      }

      if (supportsDate) {
        ensureDateValue();
      } else if (date) {
        date.value = '';
      }

      if (!supportsDate || currentType === 'event') {
        setDateMode('created', { resetReminder: true });
        wantsReminderEvent = false;
      }

      if (reminderPrompt) {
        hideReminderPrompt();
      }

      const showRecurrence = currentType === 'event';
      if (recurrenceWrap) {
        recurrenceWrap.classList.toggle('show', showRecurrence);
      }
      if (!showRecurrence) {
        setRecurrenceEnabled(false);
        selectedRecurrenceDays = new Set();
        recurrenceDaysTouched = false;
        syncRecurrenceDayButtons();
      } else {
        if (!recurrenceDaysTouched || selectedRecurrenceDays.size === 0) {
          resetRecurrenceDaysToAnchor();
        }
        syncRecurrenceVisibility();
      }

      refreshAddEnabled();
    });

    // Add event listeners for input changes
    name.addEventListener('input', refreshAddEnabled);
    if (date) date.addEventListener('change', handleDateFieldChange);
    externalUrl.addEventListener('input', refreshAddEnabled);

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.chat-prov');
      if (!btn) return;
      document.querySelectorAll('.chat-prov').forEach(b=> b.classList.remove('active'));
      btn.classList.add('active');
      selectedProvider = btn.dataset.prov;
      // populate models
      chatModel.innerHTML = '';
      (providers[selectedProvider]||[]).forEach(m => {
        const opt = document.createElement('option');
        opt.value = m; opt.textContent = m;
        chatModel.appendChild(opt);
      });
      chatModel.style.display = '';
      refreshAddEnabled();
    });

    if (addBtn) {
      const create = () => {
        const title = name.value.trim();
        if (!title) return;
        const t = type.value;
        const supportsDateType = t !== 'chat' && t !== 'external';
        const tag = tagSel.value || null;

        let chat = null;
        let externalData = null;
        if (t === 'chat') {
          if (!selectedProvider) return;
          chat = { provider: selectedProvider, model: chatModel.value || (providers[selectedProvider]?.[0] || 'default-model') };
        } else if (t === 'external') {
          const url = externalUrl.value.trim();
          if (!url) return;
          externalData = { url };
        }

        const defaultDate = todayIso();
        let effectiveDate = defaultDate;
        if (supportsDateType) {
          ensureDateValue();
          effectiveDate = date.value || defaultDate;
        }

        if (t === 'event' && !effectiveDate) return;

        const timelineMode = t === 'event' ? 'event' : (supportsDateType ? dateMode : 'created');
        const scheduledDate = t === 'event' ? effectiveDate : (supportsDateType ? effectiveDate : null);
        const dueDate = (t === 'event' || timelineMode === 'due') ? effectiveDate : null;
        const dateValueForItem = timelineMode ? effectiveDate : defaultDate;

        let recurrence = null;
        if (t === 'event' && recurrenceEnabled) {
          try {
            const anchorDateObj = parseYMDLocal(effectiveDate);
            const typeVal = recurrenceTypeSelect?.value || 'weekly';
            const rawInterval = parseInt(recurrenceIntervalSelect?.value || '1', 10) || 1;
            const interval = typeVal === 'monthly' ? 1 : Math.max(1, rawInterval);
            let days = null;
            if (typeVal !== 'monthly') {
              const baseSet = selectedRecurrenceDays.size ? selectedRecurrenceDays : new Set([anchorDateObj.getDay()]);
              days = Array.from(baseSet).map(n => Number(n)).sort((a,b)=>a-b);
            }
            const endDateObj = new Date(anchorDateObj);
            endDateObj.setFullYear(endDateObj.getFullYear() + 2);
            recurrence = {
              enabled: true,
              type: typeVal,
              interval,
              daysOfWeek: typeVal === 'monthly' ? null : days,
              dayOfMonth: anchorDateObj.getDate(),
              anchorDate: effectiveDate,
              endDate: yyyyMMdd(endDateObj)
            };
          } catch (err) {
            console.warn('Unable to compute recurrence', err);
          }
        }

        const itemType = t === 'event' ? 'event' : t;

        // Get time values for events
        let timeStart = null;
        let duration = null;
        if (itemType === 'event') {
          if (timeStartInput && timeStartInput.value) {
            timeStart = parseTimeToMinutes(timeStartInput.value);
          }
          if (durationInput && durationInput.value) {
            duration = parseInt(durationInput.value, 10);
          }
        }

        const item = OrganizerStore.create({
          name: title,
          type: itemType,
          scheduledDate,
          due: dueDate,
          tag,
          chat,
          external: externalData,
          dateMode: timelineMode,
          dateValue: dateValueForItem,
          source: { mode: 'organizer' },
          recurrence,
          timeStart,
          duration
        });

        item.panelType = (t === 'event') ? null : t;
        if (t === 'note' && scheduledDate && timelineMode !== 'due') item.subcategory = 'todo';

        let reminderEventId = null;
        if (t !== 'event' && timelineMode === 'due' && effectiveDate) {
          if (wantsReminderEvent) {
            try {
              const reminder = OrganizerStore.create({
                name: `${title} reminder`,
                type: 'event',
                scheduledDate: effectiveDate,
                due: effectiveDate,
                tag,
                dateMode: 'event',
                dateValue: effectiveDate,
                source: { mode: 'organizer', reason: 'due-reminder', parentId: item.id }
              });
              reminder.linkedItemId = item.id;
              reminderEventId = reminder.id;
            } catch (err) {
              console.warn('Unable to create reminder event', err);
            }
          }
        }

        if (reminderEventId) {
          item.reminderEventId = reminderEventId;
        }

        if (t !== 'event') {
          const initialTags = tag ? [tag] : [];
          panelManager.createNewPanel(t, title, {
            source: 'organizer',
            organizerItemId: item.id,
            initialTags,
            chat,
            external: externalData
          });
        }

        const calendarRefreshDate = (t === 'event' || reminderEventId) ? effectiveDate : null;
        if (calendarRefreshDate) {
          try {
            renderCalendarOverlay();
            if (calendarRefreshDate) {
              updateCalDaily(calendarRefreshDate);
            }
          } catch {}
        }

        OrganizerStore.save?.();

        name.value = '';
        tagSel.value = '';
        externalUrl.value = '';
        if (timeStartInput) timeStartInput.value = '';
        if (durationInput) durationInput.value = '';
        selectedProvider = null;
        chatModel.style.display='none';
        chatModel.innerHTML='';
        document.querySelectorAll('.chat-prov').forEach(b=> b.classList.remove('active'));
        resetDateFieldToToday();
        setDateMode('created', { resetReminder: true });
        hideReminderPrompt();
        wantsReminderEvent = false;
        selectedRecurrenceDays = new Set();
        recurrenceDaysTouched = false;
        setRecurrenceEnabled(false);
        syncRecurrenceDayButtons();
        if (type.value === 'event') syncRecurrenceVisibility();
        refreshAddEnabled();
        renderOrganizerList();
      };
      addBtn.addEventListener('click', create);
      name.addEventListener('input', refreshAddEnabled);
      if (date) {
        date.addEventListener('input', handleDateFieldChange);
        date.addEventListener('change', handleDateFieldChange);
      }
      name.addEventListener('keypress', (e)=> { if (e.key==='Enter') create(); });
    }

    //specify cal-daily and add event listener 
    const calDaily = document.getElementById('cal-daily');
    if (calDaily) {
      calDaily.addEventListener('click', (e) => {
      openOrganizer('event'); 
      });
    }
  }  );

  function enterCalendarMode() {
    // Inline: set background to black
    const orgModal = document.getElementById('organizer-modal');
    const orgPanel = document.querySelector('.organizer-panel'); 
    const orgHeader = document.getElementById('orghead');
    const orgControls = document.querySelector('.organizer-controls');
    const dragWrap = document.getElementById('cal-drag-wrap');
    const calPanel = document.getElementById('cal-panel');

    // Mark organizer as being in calendar mode for CSS overrides
    if (orgModal) orgModal.classList.add('org-cal-mode');

    // Shrink header inline
    if (orgHeader) {
      orgHeader.style.maxHeight = '1px';
      orgHeader.style.opacity = '0';
      orgHeader.style.height = '0';
      orgHeader.style.padding = '0';
      orgHeader.style.border = '0';
      orgHeader.style.overflow = 'hidden';
    }
    if (orgPanel){
      orgPanel.style.top = '80vh';
    }

    // Move existing calendar pieces into organizer panel (no overlay)
    try {
      const target = orgModal || document.body;
      ['cal-drag-wrap'].forEach(id => {
        const el = document.getElementById(id);
        if (el && el.parentNode !== target) target.appendChild(el);
            calPanel.style.pointerEvents = 'all';
            dragWrap.style.pointerEvents = 'all';

      });
      const sidebar = document.querySelector('aside.sidebar');
      if (sidebar && sidebar.parentNode !== (orgModal || document.body)) {
        (orgModal || document.body).appendChild(sidebar);
      }
    } catch {}

    // Activate calendar UI without overlay
    const wrap = document.getElementById('cal-drag-wrap');
    const panel = document.getElementById('cal-panel');
    if (panel) panel.classList.add('active');
    if (wrap) {
      wrap.style.position = 'fixed';
      // center panel similarly to prior overlay behavior
