          function initSidebarActiveToggle() {
             const sidebar = document.querySelector('.sidebar');
             if (!sidebar) return;
             // Wrap top-level SVGs to allow padded backgrounds without clipping
             Array.from(sidebar.children).forEach(child => {
               if (child.tagName && child.tagName.toLowerCase() === 'svg') {
                 const wrap = document.createElement('div');
                 wrap.className = 'icon-wrap';
                 sidebar.insertBefore(wrap, child);
                 wrap.appendChild(child);
               }
             });
             const icons = Array.from(sidebar.querySelectorAll('svg'));
             if (!icons.length) return;
             const storageKey = 'future.sidebar.activeIndex';
             function setActiveByIndex(idx) {
               icons.forEach(el => el.classList.remove('active'));
               const target = icons[idx];
               if (target) target.classList.add('active');
             }
             // Restore last active if available
             const stored = localStorage.getItem(storageKey);
             const storedIndex = stored !== null ? parseInt(stored, 10) : NaN;
             if (!Number.isNaN(storedIndex) && storedIndex >= 0 && storedIndex < icons.length) {
               setActiveByIndex(storedIndex);
             } else {
               // Ensure only one active at start (favor the first found)
               const firstActive = icons.findIndex(el => el.classList.contains('active'));
               setActiveByIndex(firstActive >= 0 ? firstActive : 0);
             }
             // Attach listeners on both the svg and its wrapper for easier clicking
             const wraps = Array.from(sidebar.querySelectorAll('.icon-wrap'));

             // Identify the last two icons as door open (first) and door closed (second)
             const openIdx = icons.length - 2;
             const closedIdx = icons.length - 1;
             const openWrap = wraps[openIdx];
             const closedWrap = wraps[closedIdx];

             // General click handler for non-door icons
             icons.forEach((el, index) => {
               if (index === openIdx || index === closedIdx) return; // handled separately
               const handler = () => {
                 setActiveByIndex(index);
                 localStorage.setItem(storageKey, String(index));
               };
               el.addEventListener('click', handler);
               if (wraps[index]) wraps[index].addEventListener('click', handler);
             });

             // Door toggle state (persisted) 
             const doorKey = 'future.sidebar.doorState'; // 'open' | 'closed'
             function applyDoorState(state, opts = { updateActive: false }) {
               const isClosed = state === 'closed';
               if (openWrap) openWrap.style.display = isClosed ? 'none' : '';
               if (closedWrap) closedWrap.style.display = isClosed ? '' : 'none';
               sidebar.classList.toggle('bye', isClosed);
               localStorage.setItem(doorKey, isClosed ? 'closed' : 'open');
               if (opts.updateActive) {
                 setActiveByIndex(isClosed ? closedIdx : openIdx);
                 localStorage.setItem(storageKey, String(isClosed ? closedIdx : openIdx));
               }
             }

             // Initialize door visibility
             const savedDoor = localStorage.getItem(doorKey);
             applyDoorState(savedDoor === 'closed' ? 'closed' : 'open', { updateActive: false });

             // Toggle on click for either door icon/wrapper
             const toggleDoor = () => {
               const cur = localStorage.getItem(doorKey) === 'closed' ? 'closed' : 'open';
               applyDoorState(cur === 'closed' ? 'open' : 'closed', { updateActive: true });
             };
             if (openWrap) openWrap.addEventListener('click', toggleDoor);
             if (closedWrap) closedWrap.addEventListener('click', toggleDoor);
           }


           // Auto-init on DOMContentLoaded
           document.addEventListener('DOMContentLoaded', initSidebarActiveToggle);


