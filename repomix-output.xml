  // Local-date formatter to avoid UTC shift (was using toISOString)
  function yyyyMMdd(d){
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }
  // Parse YYYY-MM-DD as a local date (not UTC) for display formatting
  function parseYMDLocal(s){
    const [y, m, d] = (s || '').split('-').map(n => parseInt(n, 10));
    if (!y || !m || !d) return new Date();
    return new Date(y, m - 1, d);
  }
  function addDaysLocal(date, days){
    const next = new Date(date.getTime());
    next.setDate(next.getDate() + days);
    return next;
  }

  // Time utilities for event start/duration
  function formatTimeFromMinutes(minutes) {
    // Convert minutes since midnight to HH:MM format
    if (minutes == null) return '';
    const hours = Math.floor(minutes / 60);
    const mins = minutes % 60;
    return `${String(hours).padStart(2, '0')}:${String(mins).padStart(2, '0')}`;
  }

  function parseTimeToMinutes(timeStr) {
    // Parse HH:MM or H:MM format to minutes since midnight
    if (!timeStr) return null;
    const parts = timeStr.split(':');
    if (parts.length !== 2) return null;
    const hours = parseInt(parts[0], 10);
    const minutes = parseInt(parts[1], 10);
    if (isNaN(hours) || isNaN(minutes)) return null;
    return hours * 60 + minutes;
  }

  function formatDuration(durationMinutes) {
    // Format duration in minutes to human-readable string
    if (!durationMinutes) return '';
    if (durationMinutes < 60) return `${durationMinutes}min`;
    const hours = Math.floor(durationMinutes / 60);
    const minutes = durationMinutes % 60;
    if (minutes === 0) return `${hours}h`;
    return `${hours}h ${minutes}min`;
  }

  function formatTime12Hour(minutes) {
    // Convert minutes since midnight to 12-hour format with AM/PM
    if (minutes == null) return '';
    const hours24 = Math.floor(minutes / 60);
    const mins = minutes % 60;
    const period = hours24 >= 12 ? 'PM' : 'AM';
    const hours12 = hours24 === 0 ? 12 : hours24 > 12 ? hours24 - 12 : hours24;
    const minsStr = String(mins).padStart(2, '0');
    return `${hours12}:${minsStr}${period}`;
  }

  function formatTimeRange(startMinutes, durationMinutes) {
    // Format a time range like "10:30AM - 12:00PM"
    if (startMinutes == null) return '';
    const startTime = formatTime12Hour(startMinutes);
    if (durationMinutes == null) return startTime;

    const endMinutes = startMinutes + durationMinutes;
    const endTime = formatTime12Hour(endMinutes);

    return `${startTime} - ${endTime}`;
  }

  function eventOccursOnDate(event, dateStr){
    if (!event || event.type !== 'event') return false;
    const compareDates = [event.scheduledDate, event.due, event.dateValue].filter(Boolean);
    if (!event.recurrence || !event.recurrence.enabled) {
      return compareDates.includes(dateStr);
    }
    const recurrence = event.recurrence || {};
    const anchorIso = recurrence.anchorDate || event.scheduledDate || event.dateValue || compareDates[0];
    if (!anchorIso) return compareDates.includes(dateStr);
    const anchor = parseYMDLocal(anchorIso);
    const target = parseYMDLocal(dateStr);
    if (!anchor || !target) return false;
    const anchorStart = new Date(anchor.getFullYear(), anchor.getMonth(), anchor.getDate());
    const targetStart = new Date(target.getFullYear(), target.getMonth(), target.getDate());
    if (compareDates.includes(dateStr)) return true;
    if (targetStart < anchorStart) return false;
    const endIso = recurrence.endDate;
    if (endIso) {
      const endDate = parseYMDLocal(endIso);
      if (targetStart > endDate) return false;
    } else {
      const fallbackEnd = new Date(anchorStart);
      fallbackEnd.setFullYear(fallbackEnd.getFullYear() + 2);
      if (targetStart > fallbackEnd) return false;
    }
    const type = recurrence.type || 'weekly';
    const interval = Math.max(1, recurrence.interval || 1);
    if (type === 'monthly') {
      const anchorDay = anchorStart.getDate();
      const monthsApart = (targetStart.getFullYear() - anchorStart.getFullYear()) * 12 + (targetStart.getMonth() - anchorStart.getMonth());
      if (monthsApart < 0) return false;
      if (monthsApart % interval !== 0) return false;
      return targetStart.getDate() === anchorDay;
    } else {
      const daysOfWeek = Array.isArray(recurrence.daysOfWeek) && recurrence.daysOfWeek.length
        ? recurrence.daysOfWeek.map(Number)
        : [anchorStart.getDay()];
      if (!daysOfWeek.includes(targetStart.getDay())) return false;
      const diffDays = Math.floor((targetStart - anchorStart) / 86400000);
      if (diffDays < 0) return false;
      return Math.floor(diffDays / 7) % interval === 0;
    }
  }
  function enumerateDates(startDate, endDate){
    const dates = [];
    const cursor = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
    const limit = new Date(endDate.getFullYear(), endDate.getMonth(), endDate.getDate());
    while (cursor <= limit){
      dates.push(yyyyMMdd(cursor));
      cursor.setDate(cursor.getDate() + 1);
    }
    return dates;
  }
  // Calendar view state helpers (Jan 2025 .. Jan 2027)
  function ensureCalView(){
    const min = { y: 2025, m: 0 };
    const max = { y: 2027, m: 0 };
    state.calendar = state.calendar || {};
    const cv = state.calendar;
    let y = Number.isFinite(cv.viewYear) ? cv.viewYear : (new Date()).getFullYear();
    let m = Number.isFinite(cv.viewMonth) ? cv.viewMonth : (new Date()).getMonth();
    const toIndex = (Y,M)=> Y*12+M;
    const idx = toIndex(y,m);
    const imin = toIndex(min.y, min.m);
    const imax = toIndex(max.y, max.m);
    const clamp = Math.max(imin, Math.min(imax, idx));
    if (clamp !== idx) { y = Math.floor(clamp/12); m = clamp % 12; }
    cv.viewYear = y; cv.viewMonth = m;
    return { y, m };
  }
  function setCalView(y, m){
    const toIndex = (Y,M)=> Y*12+M;
    const imin = toIndex(2025,0), imax = toIndex(2027,0);
    let idx = toIndex(y,m);
    idx = Math.max(imin, Math.min(imax, idx));
    state.calendar.viewYear = Math.floor(idx/12);
    state.calendar.viewMonth = idx % 12;
    saveLocal();
    renderCalendarOverlay();
  }
  function shiftCalView(delta){
    const cv = ensureCalView();
    const idx = cv.y*12 + cv.m + delta;
    setCalView(Math.floor(idx/12), idx%12);
  }
  function renderCalendarOverlay() {
    const grid = document.getElementById('cal-grid');
    if (!grid) return;
    grid.innerHTML = '';
    // headers
    ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(h=>{
      const hd = document.createElement('div'); hd.className='cal-dayheader'; hd.textContent=h; grid.appendChild(hd);
    });
    const cv = ensureCalView();
    const y = cv.y; const m = cv.m;
    const firstDay = new Date(y, m, 1).getDay();
    const daysInMonth = new Date(y, m+1, 0).getDate();
    const daysInPrev = new Date(y, m, 0).getDate();
    // previous month pads
    for (let i=firstDay-1;i>=0;i--) {
      const cell = makeCalCellOverlay(daysInPrev - i, true);
      grid.appendChild(cell);
    }
    // current month
    for (let d=1; d<=daysInMonth; d++) {
      const cell = makeCalCellOverlay(d, false);
      grid.appendChild(cell);
    }
    // trailing pads
    const total = firstDay + daysInMonth;
    const pad = (7*7) - total; // headers + 6 weeks
    for (let i=0;i<pad;i++) { const c=document.createElement('div'); c.className='cal-cell'; c.style.opacity='.25'; grid.appendChild(c); }

    populateOverlayDots();
    document.getElementById('cal-title').textContent = new Date(y,m,1).toLocaleString('en-US',{month:'long', year:'numeric'});

    // select today by default and populate daily panel
    const today = new Date();
    if (today.getFullYear() === y && today.getMonth() === m) {
      const todayStr = yyyyMMdd(today);
      const todayCell = grid.querySelector(`.cal-cell[data-date="${todayStr}"]`);
      if (todayCell) { todayCell.classList.add('selected'); openCalDayDetail(todayStr); }
    } else {
      const firstCell = grid.querySelector('.cal-cell[data-date]');
      if (firstCell) { firstCell.classList.add('selected'); openCalDayDetail(firstCell.dataset.date); }
    }

    // keyboard navigation
    grid.tabIndex = 0;
    grid.onkeydown = (e)=>{
      const sel = grid.querySelector('.cal-cell.selected');
      const focusables = [...grid.querySelectorAll('.cal-cell')];
      const idx = focusables.indexOf(sel || focusables.find(c=>!c.dataset.pad));
      let next = idx;
      if (e.key==='ArrowRight') next = Math.min(focusables.length-1, idx+1);
      if (e.key==='ArrowLeft') next = Math.max(0, idx-1);
      if (e.key==='ArrowDown') next = Math.min(focusables.length-1, idx+7);
      if (e.key==='ArrowUp') next = Math.max(0, idx-7);
      if (next!==idx) { focusables.forEach(c=>c.classList.remove('selected')); focusables[next].classList.add('selected'); }
      if (e.key==='Enter') { const c = focusables[next]; if (c) openCalDayDetail(c.dataset.date); }
    };
    grid.onwheel = (e)=>{
      if (Math.abs(e.deltaY) < 2) return;
      e.preventDefault();
      shiftCalView(e.deltaY > 0 ? +1 : -1);
    };
  }

  function makeCalCellOverlay(day, isPad){
    const cell = document.createElement('div'); cell.className='cal-cell'; if (isPad) cell.dataset.pad='1';
