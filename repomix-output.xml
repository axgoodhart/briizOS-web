    normalizeOnRead(id, data) {
      return {
        id: String(id),
        type: data.type || 'note',
        title: data.title || data.name || '',
        body: data.body || data.description || data.content || '',
        status: data.completedAt ? 'done' : (data.status === 'done' ? 'done' : (data.status || 'todo')),
        completedAt: data.completedAt || null,
