              <div class="chat-messages" id="chat-messages-${panel.id}">
                <div class="chat-message assistant">
                  <strong>AI:</strong> Hello! I'm here to help you organize your thoughts and tasks. What can I do for you?
                </div>
              </div>
              <input type="text" class="chat-input" id="chat-input-${panel.id}" placeholder="Type your message..." 
                     onkeypress="if(event.key==='Enter') chatManager.sendMessage('${panel.id}')">
            </div>
          `;
        
        case 'calendar':
          return `
