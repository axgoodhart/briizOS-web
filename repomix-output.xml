      if (!el) return;

      const panel = this.panels.find(p => p.id === panelId);
      if (!panel) return;

      el.classList.add('panel-flipped');

      // Hide edit mode if active
      if (this.editingPanel === el) {
        this.exitEditMode();
      }
    }

    flipToFront(panelId) {
      const el = document.querySelector(`[data-panel-id="${panelId}"]`);
      if (!el) return;



