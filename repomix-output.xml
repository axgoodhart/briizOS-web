        importance: data.importance || null,
        deadline: data.deadline || null,
        attachments: data.attachments || [],
        links: data.links || [],
      };
    },
    prepareForWrite(d, isNew = false) {
      strId(d);
      stamp(d, isNew);
      if (!d.title && d.name) d.title = d.name;
      if (!d.body && (d.description || d.content)) d.body = d.description || d.content;
