updateTime() {
  const now = new Date();
  const timeString = now.toLocaleTimeString('en-US', { 
    hour12: false, 
    hour: '2-digit', 
    minute: '2-digit' 
  });

  const day = now.getDate();
  const ordinalDay = day % 10 === 1 && day !== 11 ? day + 'ST' :
                     day % 10 === 2 && day !== 12 ? day + 'ND' :
                     day % 10 === 3 && day !== 13 ? day + 'RD' : day + 'TH';

  const dateString = `${now.toLocaleDateString('en-US', { weekday: 'short' }).toUpperCase()}.${now.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}.${ordinalDay}`;

  document.getElementById('current-time').textContent = timeString;
  document.getElementById('current-date').textContent = dateString;
};
