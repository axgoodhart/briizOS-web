    console.log('  1. Team Standup: ' + formatTimeRange(event1.start, event1.duration));
    console.log('  2. Lunch with Client: ' + formatTimeRange(event2.start, event2.duration));
    console.log('  3. Design Workshop: ' + formatTimeRange(event3.start, event3.duration));

    // Refresh the calendar display
    updateCalDaily(today);
    renderCalendarOverlay();

    return [event1, event2, event3];
  };

