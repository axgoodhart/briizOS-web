  function updateCalDaily(dateStr){
    OrganizerStore.load();

    // Update both original and clone
    const lists = [
      document.getElementById('cal-daily-list'),
      calDailyClone ? calDailyClone.querySelector('#cal-daily-list') : null
    ].filter(Boolean);

    const titles = [
      document.getElementById('cal-daily-title'),
      calDailyClone ? calDailyClone.querySelector('#cal-daily-title') : null
    ].filter(Boolean);

    titles.forEach(title => {
      if (title) title.textContent = parseYMDLocal(dateStr).toLocaleDateString('en-US',{weekday:'long', month:'long', day:'numeric'});
    });

    if (lists.length === 0) return;

    lists.forEach(list => {
      list.innerHTML = '';
    });

    // Check if viewing today
    const today = new Date();
    const todayStr = yyyyMMdd(today);
    const isToday = dateStr === todayStr;

    // Populate all lists
    lists.forEach(list => {
      if (isToday) {
        // Show today's events
        const todayItems = OrganizerStore.items.filter(it=> it.type === 'event' && eventOccursOnDate(it, dateStr));

        if (todayItems.length === 0) {
          const d = document.createElement('div');
          d.className = 'org-feed-empty';
          d.textContent = 'today: no items scheduled';
          list.appendChild(d);
        } else {
          const d = document.createElement('div');
          d.className = 'org-feed-empty you-thought';
          d.textContent = '✦';

          todayItems.forEach(it => {
            renderEventRow(it, dateStr, list, 1.0); // Full opacity
          });
        }

        // Add separator
        const separator = document.createElement('div');
        separator.style.cssText = 'margin-top: 24px; margin-bottom: 12px; padding-top: 16px; border-top: 1px solid rgba(0,255,255,0.2); font-size: 12px; opacity: 0.6; text-transform: uppercase; letter-spacing: 1px;';
        separator.textContent = 'Upcoming (Next 7 Days)';
        list.appendChild(separator);

        // Show next 7 days
        let hasFutureEvents = false;
        for (let i = 1; i <= 7; i++) {
          const futureDate = addDaysLocal(today, i);
          const futureDateStr = yyyyMMdd(futureDate);
          const futureItems = OrganizerStore.items.filter(it=> it.type === 'event' && eventOccursOnDate(it, futureDateStr));

          futureItems.forEach(it => {
            hasFutureEvents = true;
            renderEventRow(it, futureDateStr, list, 0.6); // Lower opacity
          });
        }

        // If no future events
        if (!hasFutureEvents) {
          const d = document.createElement('div');
          d.className = 'org-feed-empty';
          d.style.opacity = '0.6';
          d.textContent = 'No upcoming events';
          list.appendChild(d);
        }
      } else {
        // Not today - show just this date's events (original behavior)
        const items = OrganizerStore.items.filter(it=> it.type === 'event' && eventOccursOnDate(it, dateStr));
        if (!items.length) {
          const d = document.createElement('div');
          d.className = 'org-feed-empty';
          d.textContent = 'No items';
          list.appendChild(d);
        } else {
          items.forEach(it => {
            renderEventRow(it, dateStr, list, 1.0);
          });
        }
      }
    });
    }
  

  // Helper function to render event row
  function renderEventRow(it, dateStr, list, opacity) {
    const r = document.createElement('div');
    r.className = 'row';
    r.style.opacity = opacity;

    const left = document.createElement('div');

    // Create elegant time display
    let timeDisplay = '';
    if (it.start != null) {
      // If we have a start time and duration, show the range
      if (it.duration != null) {
        timeDisplay = formatTimeRange(it.start, it.duration);
      } else {
        // Just show the start time in 12-hour format
        timeDisplay = formatTime12Hour(it.start);
      }
    }

    // Format: Event Name on first line, time range on second line
    if (timeDisplay) {
      left.innerHTML = `<div style="font-weight: 500; margin-bottom: 4px;">${escapeHtml(it.name)}</div>
                        <div style="font-size: 0.9em; opacity: 0.8;">${timeDisplay}</div>`;
    } else {
      // No time specified, just show the name
      left.innerHTML = `<div style="font-weight: 500;">${escapeHtml(it.name)}</div>`;
    }

    const btn = document.createElement('button');
    btn.textContent = it.completedAt ? 'Undo' : 'Done';
    btn.style.cssText = `
      padding: 4px 12px;
      border-radius: 8px;
      background: ${it.completedAt ? 'rgba(100, 100, 100, 0.3)' : 'rgba(0, 255, 204, 0.1)'};
      border: 1px solid ${it.completedAt ? 'rgba(150, 150, 150, 0.4)' : 'rgba(0, 255, 204, 0.3)'};
      color: ${it.completedAt ? 'rgba(255, 255, 255, 0.6)' : '#00ffcc'};
      cursor: pointer;
      font-size: 0.85em;
      transition: all 0.2s ease;
      white-space: nowrap;
    `;
    btn.addEventListener('mouseenter', () => {
      btn.style.background = it.completedAt ? 'rgba(100, 100, 100, 0.5)' : 'rgba(0, 255, 204, 0.2)';
    });
    btn.addEventListener('mouseleave', () => {
      btn.style.background = it.completedAt ? 'rgba(100, 100, 100, 0.3)' : 'rgba(0, 255, 204, 0.1)';
    });
    btn.addEventListener('click', ()=>{
      OrganizerStore.toggleDone(it.id);
      updateCalDaily(dateStr);
      renderCalendarOverlay();
      renderOrganizerList();
    });

    // Style the row for better alignment
    r.style.alignItems = 'center';
    r.style.gap = '12px';
    left.style.flex = '1';

    r.appendChild(left);
    r.appendChild(btn);
    list.appendChild(r);
  }

