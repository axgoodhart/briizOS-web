      const tr = document.createElement('tr'); tr.className = 'org-empty';
      tr.innerHTML = `<td colspan="5">No items yet — add one above.</td>`;
      tbody.appendChild(tr); return;
    }
    // Get filtered and sorted rows
    const rows = OrganizerFilterSort.getFilteredAndSortedItems();
    if (!rows.length) {
      const tr = document.createElement('tr'); tr.className = 'org-empty';
      tr.innerHTML = `<td colspan="5">No items match current filter.</td>`;
      tbody.appendChild(tr); return;
    }
    rows.forEach(it => {
      const tr = document.createElement('tr');
      const dateMode = it.dateMode || (it.type === 'event' ? 'event' : 'created');
      const createdStamp = toLocalYMDFromTs(it.createdAt) || '';
      let schedDisplay = '';
      let dueDisplay = '';
      if (it.type === 'event') {
        schedDisplay = it.scheduledDate || it.dateValue || '';
        // Add time to display if available
        if (it.start != null) {
          schedDisplay += ' ' + formatTimeFromMinutes(it.start);
          if (it.duration != null) {
            schedDisplay += ' (' + formatDuration(it.duration) + ')';
          }
        }
        dueDisplay = it.due || it.dateValue || '';
      } else if (dateMode === 'due') {
        schedDisplay = createdStamp || it.scheduledDate || it.dateValue || '';
        dueDisplay = it.due || it.dateValue || '';
      } else {
        schedDisplay = it.scheduledDate || it.dateValue || createdStamp;
        dueDisplay = '';
      }
      const statusClass = it.completedAt ? 'org-status done' : 'org-status';
      // active on screen?
      let isActive = false;
      try {
        if (it.panelId) {
          const el = document.querySelector(`.dynamic-panel[data-panel-id="${it.panelId}"]`);
          isActive = !!el;
