      }
    }

    initializePanelContent(panelElement, panel) {
      if (panel.type === 'note') {
        const textarea = panelElement.querySelector('.notes-editor');
        const contentEl = panelElement.querySelector('.panel-content');
        const syncTextareaToContent = () => {
          if (!textarea || !contentEl) return;
          const avail = Math.max(60, contentEl.clientHeight);
          textarea.style.height = avail + 'px';
          textarea.style.overflow = 'auto';
        };
        // Ensure properties exist
        if (typeof panel.expansionCount !== 'number') panel.expansionCount = 0;
        if (typeof panel.autoHeight !== 'boolean') panel.autoHeight = true;

        // Base size relative to window if no saved dimensions
        const applyBaseSizeFromWindow = (persist = true) => {
          if (panel.w && panel.h) return; // respect saved sizes
          const baseW = Math.max(280, Math.floor(window.innerWidth * 0.28));
          const baseH = Math.max(500, Math.floor(panelElement.style.height * 0.30));
          panelElement.style.width = baseW + 'px';
          panelElement.style.height = (baseH + 60) + 'px';
          textarea.style.height = baseH + 'px';
          if (persist) {
            panel.w = baseW; panel.h = baseH + 60;
            this.touchPanel(panel, { w: panel.w, h: panel.h });
            stagePanelPatch(panel.id, { w: panel.w, h: panel.h });
            scheduleCommit(60_000);
            try { persistence.savePanel(panel); } catch {}
          }
        };

        applyBaseSizeFromWindow(false);

        // Responsive update when window resizes only if not expanded yet
        const onWinResize = () => {
          if (panel.expansionCount > 0 || panel.autoHeight === false) return;
          applyBaseSizeFromWindow(false);
        };
        window.addEventListener('resize', onWinResize);

        // Resize/expand behavior
        const ensureScrollPosition = () => {
          // Outside edit mode: show top; In edit mode: keep bottom at ~60% height
          if (panelElement.classList.contains('editing')) {
            const target = Math.max(0, textarea.scrollHeight - Math.floor(textarea.clientHeight * 0.60));
            textarea.scrollTop = target;
          } else {
            textarea.scrollTop = 0;
          }
        };

        const maybeExpandOnOverflow = () => {
          // Only expand if content exceeds current textbox height
          const overflow = textarea.scrollHeight > textarea.clientHeight + 2;
          if (!overflow) return;

          if (panel.expansionCount === 0) {
            // 1st expansion: 1.5x height
            const newTaH = Math.floor(textarea.clientHeight * 1.5);
            textarea.style.height = newTaH + 'px';
            const newPanelH = newTaH + 60;
            panelElement.style.height = newPanelH + 'px';
            panel.expansionCount = 1;
            panel.h = newPanelH;
            panel.autoHeight = false; // lock size after manual expansions
            this.touchPanel(panel, { h: panel.h, autoHeight: false, expansionCount: panel.expansionCount });
            stagePanelPatch(panel.id, { h: panel.h, autoHeight: false, expansionCount: panel.expansionCount });
            scheduleCommit(60_000);
            try { persistence.savePanel(panel); } catch {}
          } else if (panel.expansionCount === 1) {
            // 2nd expansion: +1.25x height and double width
            const newTaH = Math.floor(textarea.clientHeight * 1.25);
            const newPanelH = newTaH + 60;
            const newPanelW = Math.min(panelElement.offsetWidth * 2, Math.max(320, window.innerWidth - 40));
            textarea.style.height = newTaH + 'px';
            panelElement.style.height = newPanelH + 'px';
            panelElement.style.width = newPanelW + 'px';
            panel.expansionCount = 2;
            panel.h = newPanelH; panel.w = newPanelW;
            panel.autoHeight = false;
            this.touchPanel(panel, { h: panel.h, w: panel.w, autoHeight: false, expansionCount: panel.expansionCount });
            stagePanelPatch(panel.id, { h: panel.h, w: panel.w, autoHeight: false, expansionCount: panel.expansionCount });
            scheduleCommit(60_000);
            try { persistence.savePanel(panel); } catch {}
          } else {
            // 3rd+ time: no size change; maintain scroll behavior
          }
        };

        const hydrateInitialHeights = () => {
          if (panel.h && panel.w) {
            // Respect persisted size; set textarea to fit panel minus chrome
            syncTextareaToContent();
          } else {
            // Use base sizing from window
            applyBaseSizeFromWindow(false);
          }
          ensureScrollPosition();
        };

        // Event wiring
        textarea.addEventListener('input', () => {
          panel.content = textarea.value;
          stagePanelPatch(panel.id, { content: panel.content });
          scheduleCommit(60_000);
          // Don't shrink; only expand on overflow
          maybeExpandOnOverflow();
          ensureScrollPosition();
        });
        textarea.addEventListener('paste', () => setTimeout(() => { maybeExpandOnOverflow(); ensureScrollPosition(); }, 50));

        // Keep textarea synced to panel size changes
        try {
          const ro = new ResizeObserver(() => syncTextareaToContent());
          ro.observe(panelElement);
        } catch {}
        hydrateInitialHeights();
      } else if (panel.type === 'calendar') {
        calendarManager.renderCalendar(panel.id);
      } else if (panel.type === 'external') {
        if (externalManager && typeof externalManager.initializeExternalPanel === 'function') {
          externalManager.initializeExternalPanel(panel.id, panelElement, this);
        }
      } else if (panel.type === 'custom-panel') {
        // Initialize the chat module for custom panels
        const container = panelElement.querySelector(`#chat-wrapper-${panel.id}`);

        // Ensure ChatWidget is loaded
        const initChat = () => {
          if (container && window.ChatWidget) {
            // Create a new chat widget instance
            const chatInstance = new ChatWidget(container, panel.id);
            // Store reference on panel for lifecycle management
            panel.customInstance = chatInstance;

            // For cw panels: clicking anywhere in the chat area should focus the input
            panelElement.addEventListener('click', (e) => {
              if (!panelElement.classList.contains('cw-panel')) return;
              const input = panelElement.querySelector('.cw-textarea');
              if (!input) return;
              // Ignore clicks on native controls or buttons
              if (e.target.closest('textarea, input, button, select, [contenteditable]')) return;
              if (e.target.closest('.cw-nav')) return;
              // Focus the chat input without toggling OS edit mode
              input.focus();
            });

            // (reverted paint/compositing nudge)
          } else if (!window.ChatWidget) {
            // Try again in a moment if ChatWidget isn't loaded yet
            setTimeout(initChat, 100);
          }
        };

        // Initialize immediately or after a small delay
        if (window.ChatWidget) {
          initChat();
        } else {
          setTimeout(initChat, 100);
        }
      } else if (panel.type === 'jobPanel') {
        this.initializeJobPanel(panelElement, panel);
      }
    }

    // ─── JOB PANEL: live actions editing ─────────────────────────────────
    initializeJobPanel(panelElement, panel) {
      const taskId = panel.taskId || panel.id;
      const actionsContainer = panelElement.querySelector(`[data-actions-panel="${panel.id}"]`);
      const actionInput = panelElement.querySelector(`[data-action-input="${panel.id}"]`);
      const statusLight = panelElement.querySelector('.job-status-light');
      const badgeEl = panelElement.querySelector('.job-badge');
      if (!actionsContainer) return;

      // Helper: get current task data from Firestore-synced state
      const getTaskData = () => (window.briizPersistence?.state?.tasks || []).find(t => t.id === taskId);

      // Helper: save updated actions array back to Firestore
      const saveActions = (actions) => {
        if (!window.briizPersistence) return;
        window.briizPersistence.queueFirebaseSave('tasks', taskId, { actions });
        // Also update in-memory state
        const task = getTaskData();
        if (task) task.actions = actions;
      };

      // Render the actions list from task data
      const renderActions = () => {
        const task = getTaskData();
        const actions = (task && Array.isArray(task.actions)) ? task.actions : [];
        const ol = actionsContainer.querySelector('.job-actions-ol');
        if (!ol) return;

        if (actions.length === 0) {
          ol.innerHTML = '<li class="job-action-empty">Awaiting local agent</li>';
        } else {
          // Sort oldest first (by `created` timestamp)
          const sorted = [...actions].sort((a, b) => (a.created || 0) - (b.created || 0));
          ol.innerHTML = sorted.map((action, idx) => `
            <li class="job-action-item ${action.completed ? 'completed' : ''}" data-action-id="${action.id}">
              <button class="job-action-check" title="Toggle complete">${action.completed ? '&#10003;' : '&#9675;'}</button>
              <span class="job-action-title" contenteditable="true" spellcheck="false">${this.escapeJobHtml(action.title || '')}</span>
              <button class="job-action-delete" title="Remove">&times;</button>
            </li>
          `).join('');
        }

        // Update task-level status badge/light based on actions
        if (task) {
          const allDone = actions.length > 0 && actions.every(a => a.completed);
          const taskStatus = task.status || 'running';
          if (statusLight) {
            statusLight.className = 'job-status-light ' + (allDone || taskStatus === 'complete' ? 'green' : 'pink');
          }
          if (badgeEl) {
            if (allDone || taskStatus === 'complete') {
              badgeEl.className = 'job-badge complete';
              badgeEl.textContent = 'COMPLETE';
            } else {
              badgeEl.className = 'job-badge running';
              badgeEl.textContent = 'RUNNING...';
            }
          }
        }

        // Wire up action event listeners
        ol.querySelectorAll('.job-action-item').forEach(li => {
          const actionId = li.dataset.actionId;

          // Toggle complete
          li.querySelector('.job-action-check')?.addEventListener('click', (e) => {
            e.stopPropagation();
            const task = getTaskData();
            if (!task || !Array.isArray(task.actions)) return;
            const updated = task.actions.map(a => {
              if (a.id === actionId) {
                return { ...a, completed: !a.completed, completedAt: !a.completed ? Date.now() : null };
              }
              return a;
            });
            saveActions(updated);
            renderActions();
          });

          // Inline edit title (on blur or Enter)
          const titleSpan = li.querySelector('.job-action-title');
          if (titleSpan) {
            const commitEdit = () => {
              const newTitle = titleSpan.textContent.trim();
              if (!newTitle) return; // don't save empty
              const task = getTaskData();
              if (!task || !Array.isArray(task.actions)) return;
              const updated = task.actions.map(a => {
                if (a.id === actionId && a.title !== newTitle) {
                  return { ...a, title: newTitle };
                }
                return a;
              });
              saveActions(updated);
            };
            titleSpan.addEventListener('blur', commitEdit);
            titleSpan.addEventListener('keydown', (e) => {
              if (e.key === 'Enter') { e.preventDefault(); titleSpan.blur(); }
              if (e.key === 'Escape') { titleSpan.blur(); renderActions(); }
            });
          }

          // Delete action
          li.querySelector('.job-action-delete')?.addEventListener('click', (e) => {
            e.stopPropagation();
            const task = getTaskData();
            if (!task || !Array.isArray(task.actions)) return;
            const updated = task.actions.filter(a => a.id !== actionId);
            saveActions(updated);
            renderActions();
          });
        });
      };

      // Add new action on Enter
      if (actionInput) {
        actionInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && actionInput.value.trim()) {
            e.preventDefault();
            const title = actionInput.value.trim();
            actionInput.value = '';
            const task = getTaskData();
            const actions = (task && Array.isArray(task.actions)) ? [...task.actions] : [];
            actions.push({
              id: `tasks-${Date.now()}`,
              title,
              completed: false,
              completedAt: null,
              priority: 'medium',
              created: Date.now(),
            });
            saveActions(actions);
            renderActions();
          }
        });
      }

      // Initial render
      renderActions();

      // Re-render when Firestore data updates (poll every 2s since onSnapshot updates state in place)
      const pollInterval = setInterval(() => {
        if (!document.contains(panelElement)) { clearInterval(pollInterval); return; }
        renderActions();
      }, 2000);
    }

    escapeJobHtml(str) {
      const el = document.createElement('span');
      el.textContent = str;
      return el.innerHTML;
    }

    updatePanelTitle(panelElement, title) {
      const titleElement = panelElement.querySelector('.panel-title');
      titleElement.textContent = title;

      const id = String(panelElement.dataset.panelId);
      const p = this.panels.find(x => String(x.id) === id);
      if (p) {
        p.title = title;
        this.touchPanel(p);
        this.savePanelsToStorage();
      }
    }

    enterEditMode(panelElement) {
      if (this.editingPanel) {
        this.exitEditMode();
      }

      this.editingPanel = panelElement;
      panelElement.classList.add('editing');
      const contentElement = panelElement.querySelector('.panel-content');
      
      if (contentElement.querySelector('textarea')) {
        const ta = contentElement.querySelector('textarea');
        ta.focus();
        // Scroll so newest text is visible around 60% height
        try {
          const target = Math.max(0, ta.scrollHeight - Math.floor(ta.clientHeight * 0.60));
          ta.scrollTop = target;
        } catch {}
      } else {
        contentElement.contentEditable = true;
        contentElement.focus();
      }

      // No background overrides in edit mode; hue-rotate applies at panel level
    }

    exitEditMode() {
      if (!this.editingPanel) return;

      const contentElement = this.editingPanel.querySelector('.panel-content');
      contentElement.contentEditable = false;
      this.editingPanel.classList.remove('editing');

      // Save content
      const panelId = String(this.editingPanel.dataset.panelId);
      const panel = this.panels.find(p => String(p.id) === panelId);
      if (panel) {
        const textarea = contentElement.querySelector('textarea');
        if (textarea) {
          panel.content = textarea.value;
        } else {
          panel.content = contentElement.textContent;
        }
        console.log('[note] commit', { id: String(panel.id), len: (panel.content||'').length });
        stagePanelPatch(panel.id, { content: panel.content });
        // Commit immediately on blur per your preference
        commitPendingChanges({ onlyId: panel.id });
        if (textarea) {
          textarea.style.border = 'none';
          textarea.style.background = 'none';
          // Outside edit mode, keep scroll at top
          try { textarea.scrollTop = 0; } catch {}
        }
        this.touchPanel(panel);
      }

      // Restore previous dimensions if captured
      if (this.editingPanel.dataset.prevW && this.editingPanel.dataset.prevH) {
        this.editingPanel.style.width = this.editingPanel.dataset.prevW + 'px';
        this.editingPanel.style.height = this.editingPanel.dataset.prevH + 'px';
        delete this.editingPanel.dataset.prevW;
        delete this.editingPanel.dataset.prevH;
      }

      // Restore color background variants if a custom color exists
      try {
        const id = String(this.editingPanel.dataset.panelId);
        const panel = this.panels.find(p => String(p.id) === id);
        if (panel && panel.customColor) {
          this.applyPanelColor(this.editingPanel, panel);
          const body = this.editingPanel.querySelector('.panel-body');
          if (body) body.style.removeProperty('background');
        }
      } catch {}

      this.editingPanel = null;
    }

    makeResizable(el, panel) {
      const handle = el.querySelector('.panel-resize-handle');
      if (!handle) return;
      let startX=0, startY=0, startW=0, startH=0;
      const onDown = (e) => {
        e.preventDefault(); e.stopPropagation();
        const rect = el.getBoundingClientRect();
        startX = e.clientX; startY = e.clientY;
        startW = rect.width; startH = rect.height;
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      };
      const onMove = (e) => {
        e.preventDefault();
        const dw = e.clientX - startX;
        const dh = e.clientY - startY;
        const newW = Math.max(240, startW + dw);
        const newH = Math.max(80, startH + dh);
        el.style.width = newW + 'px';
        el.style.height = newH + 'px';
        // Live sync textarea height in note panels
        try {
          const ta = el.querySelector('.notes-editor');
          const content = el.querySelector('.panel-content');
          if (ta && content) {
            ta.style.height = Math.max(60, content.clientHeight) + 'px';
          }
        } catch {}
      };
      const onUp = () => {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        // persist
        const id = String(el.dataset.panelId);
        const p = this.panels.find(x => String(x.id) === id) || panel;
        if (p) {
          p.w = el.offsetWidth;
          p.h = el.offsetHeight;
          p.autoHeight = false;
          this.touchPanel(p);
          stagePanelPatch(id, { w: p.w, h: p.h, autoHeight: p.autoHeight });
          scheduleCommit(60_000);
          try { persistence.savePanel(p); } catch {}
          // Final sync textarea height
          try {
            const ta = el.querySelector('.notes-editor');
            const content = el.querySelector('.panel-content');
            if (ta && content) {
              ta.style.height = Math.max(60, content.clientHeight) + 'px';
            }
          } catch {}
        }
      };
      handle.addEventListener('mousedown', onDown);
    }

    attachEditDrawer(panelElement, panel) {
      // avoid duplicates
      if (panelElement.querySelector('.panel-drawer')) return;
      const drawer = document.createElement('div');
      drawer.className = 'panel-drawer';
      drawer.innerHTML = `
        <span style="font-size:.9rem;color:#9ee">Worlds:</span>
        <button class="tag-toggle" data-tag="home">Home</button>
        <button class="tag-toggle" data-tag="school">School</button>
        <button class="tag-toggle" data-tag="music">Music</button>
      `;
      panelElement.appendChild(drawer);
      const syncUI = () => {
        const tags = panel.tags || [];
        drawer.querySelectorAll('.tag-toggle').forEach(btn => {
          if (tags.includes(btn.dataset.tag)) btn.classList.add('active');
          else btn.classList.remove('active');
        });
      };
      drawer.addEventListener('click', (e) => {
        const btn = e.target.closest('.tag-toggle');
        if (!btn) return;
        const t = btn.dataset.tag;
        panel.tags = panel.tags || [];
        if (panel.tags.includes(t)) panel.tags = panel.tags.filter(x => x !== t);
        else panel.tags.push(t);
        // persist and apply filter state
        this.touchPanel(panel);
        stagePanelPatch(panel.id, { tags: panel.tags });
        scheduleCommit(60_000);
        syncUI();
        this.applyWorldFilter();
        // mirror to organizer item if linked
        if (panel.orgId && window.OrganizerStore) {
          const it = OrganizerStore.items?.find(i=>i.id===panel.orgId);
          if (it) { it.tags = [...panel.tags]; OrganizerStore.save?.(); }
        }
      });
      syncUI();
    }

    // === PANEL SETTINGS SYSTEM ===

    flipToSettings(panelId) {
      const el = document.querySelector(`[data-panel-id="${panelId}"]`);
      if (!el) return;

      const panel = this.panels.find(p => p.id === panelId);
      if (!panel) return;

      el.classList.add('panel-flipped');

      // Hide edit mode if active
      if (this.editingPanel === el) {
        this.exitEditMode();
      }
    }

    flipToFront(panelId) {
      const el = document.querySelector(`[data-panel-id="${panelId}"]`);
      if (!el) return;



      el.classList.remove('panel-flipped');
      this.hideSettingDetail(el);
    }

    attachSettingsBackside(panelElement, panel) {
      const backside = panelElement.querySelector('.panel-backside');
      if (!backside) return;

      const icons = backside.querySelectorAll('.setting-icon');

      icons.forEach(icon => {
        icon.addEventListener('click', (e) => {
          e.stopPropagation();
          const setting = icon.dataset.setting;
          this.showSettingDetail(panelElement, panel, setting, icon);
        });
      });

      const backBtn = backside.querySelector('.setting-back-btn');
      backBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.hideSettingDetail(panelElement);
      });

      // Exit settings entirely (flip to front)
      const exitBtn = backside.querySelector('.setting-exit-btn');
      exitBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        this.flipToFront(panel.id);
      });

      // Close button on backside title - flips back to front
      const title = panelElement.querySelector('.panel-title');
      title.addEventListener('click', (e) => {
        if (panelElement.classList.contains('panel-flipped')) {
          e.stopPropagation();
          this.flipToFront(panel.id);
        }
      });
    }

    showSettingDetail(el, panel, settingName, iconElement) {
      const backside = el.querySelector('.panel-backside');
      backside.classList.add('detail-view');

      // Show back button and header icon
      backside.querySelector('.setting-back-btn').style.display = 'block';
      const header = backside.querySelector('.setting-icon-header');
      header.innerHTML = iconElement.innerHTML;
      header.style.display = 'block';

      // Show detail container
      const container = backside.querySelector('.setting-detail-container');
      container.style.display = 'flex';
      container.innerHTML = this.getSettingDetailContent(panel, settingName);

      // Wire up specific setting logic
      if (settingName === 'color') {
        this.initColorPicker(el, panel, container);
      }
      // Other settings will show "Coming soon..." for now
    }

    hideSettingDetail(el) {
      const backside = el.querySelector('.panel-backside');
      backside.classList.remove('detail-view');
      backside.querySelector('.setting-back-btn').style.display = 'none';
      backside.querySelector('.setting-icon-header').style.display = 'none';
      backside.querySelector('.setting-detail-container').style.display = 'none';
    }

    getSettingDetailContent(panel, setting) {
      if (setting === 'color') {
        const color = panel.customColor || { h: 180, s: 70, l: 50 };
        return `
          <div class="color-picker-container">
            <div class="color-preview" id="color-preview-${panel.id}"
                 style="background: hsl(${color.h}, ${color.s}%, ${color.l}%);"></div>

            <label>
              <span>Hue</span>
              <span id="hue-val-${panel.id}">${color.h}</span>
            </label>
            <input type="range" class="hsl-slider" data-prop="h"
                   min="0" max="360" value="${color.h}">

            <label>
              <span>Saturation</span>
              <span id="sat-val-${panel.id}">${color.s}%</span>
            </label>
            <input type="range" class="hsl-slider" data-prop="s"
                   min="0" max="100" value="${color.s}">

            <label>
              <span>Lightness</span>
              <span id="light-val-${panel.id}">${color.l}%</span>
            </label>
            <input type="range" class="hsl-slider" data-prop="l"
                   min="0" max="100" value="${color.l}">

            <button class="color-reset-btn">Reset to Default</button>
          </div>
        `;
      }

      // Stub for other settings
      const settingNames = {
        'chrome': 'Chrome Toggle',
        'lock-dimension': 'Dimension Lock',
        'link': 'Link to Panel',
        'format': 'Text Formatting',
        'pin': 'Pin Position',
        'duplicate': 'Duplicate Panel',
        'copy-to-chat': 'Copy to AI Chat',
        'password-lock': 'Password Lock'
      };

      return `
        <div style="text-align: center; padding: 40px 20px; color: #00ffcc;">
          <h3 style="margin-bottom: 16px; font-size: 1.5rem;">${settingNames[setting] || setting}</h3>
          <p style="opacity: 0.7;">Coming soon...</p>
        </div>
      `;
    }

    initColorPicker(el, panel, container) {
      const sliders = container.querySelectorAll('.hsl-slider');
      const preview = container.querySelector(`#color-preview-${panel.id}`);

      // Initialize color object if not exists
      if (!panel.customColor) {
        panel.customColor = { h: 180, s: 70, l: 50 };
      }

      const updateColor = () => {
        const h = panel.customColor.h;
        const s = panel.customColor.s;
        const l = panel.customColor.l;

        // Update preview
        preview.style.background = `hsl(${h}, ${s}%, ${l}%)`;

        // Update value displays
        container.querySelector(`#hue-val-${panel.id}`).textContent = h;
        container.querySelector(`#sat-val-${panel.id}`).textContent = s;
        container.querySelector(`#light-val-${panel.id}`).textContent = l;

      // Apply hue rotation to panel (no gradient overrides)
      this.applyPanelColor(el, panel);

        // Persist
        this.touchPanel(panel);
        this.savePanelsToStorage();
      };

      sliders.forEach(slider => {
        slider.addEventListener('input', (e) => {
          const prop = e.target.dataset.prop;
          panel.customColor[prop] = parseInt(e.target.value);
          updateColor();
        });
      });

      // Reset button
      const resetBtn = container.querySelector('.color-reset-btn');
      resetBtn.addEventListener('click', () => {
        panel.customColor = { h: 0, s: 70, l: 50 };
        sliders.forEach(s => {
          s.value = panel.customColor[s.dataset.prop];
        });
        updateColor();
      });
    }

    applyPanelColor(el, panel) {
      // Clear styles when no custom color
      if (!panel?.customColor) {
        try {
          // Remove any color filters/backgrounds applied previously
          const body = el.querySelector('.panel-body');
          if (body) {
            body.style.removeProperty('filter');
            body.style.removeProperty('background');
            body.style.removeProperty('box-shadow');
            body.style.removeProperty('border-color');
          }
          el.style.removeProperty('background');
          el.style.removeProperty('box-shadow');
          el.style.removeProperty('border-color');
          // Keep buttons untouched
          const btns = el.querySelector('.panel-buttons-container');
          if (btns) btns.style.removeProperty('filter');
          const title = el.querySelector('.panel-title');
          if (title) {
            title.style.removeProperty('background');
            title.style.removeProperty('-webkit-background-clip');
            title.style.removeProperty('-webkit-text-fill-color');
          }
        } catch {}
        return;
      }

      const { h, s, l } = panel.customColor;
      // Map saturation and lightness to CSS filter multipliers
      const sat = Math.max(0, Number(s) || 0); // 0..100
      const lig = Math.max(0, Number(l) || 0); // 0..100
      const sFactor = Math.max(0, (sat / 50));      // 50 -> 1, 100 -> 2, 0 -> 0
      const bFactor = Math.max(0.2, (lig / 50));    // 50 -> 1, clamp min 0.2

      // Apply color treatment to the entire panel element for clear effect
      el.style.filter = `hue-rotate(${Number(h)||0}deg) saturate(${sFactor}) brightness(${bFactor})`;

      // Inverse treatment for the button strip to ensure readability (optional boost)
      try {
        const btns = el.querySelector('.panel-buttons-container');
        if (btns) {
          const invH = (Number(h) + 180) % 360;
          const invS = sat > 0 ? (1 / sFactor) : 1; // avoid div by zero
          const invB = 1 / bFactor;
          btns.style.filter = `hue-rotate(${invH}deg) saturate(${invS}) brightness(${invB})`;
        }
      } catch {}
    }

    attachColorHoverHandlers(el, panel) {
      if (el._colorHoverBound) return;
      el._colorHoverBound = true;
      const onEnter = () => {
        if (!panel.customColor) return;
        const { h, s, l } = panel.customColor;
        const color = `hsl(${h}, ${s}%, ${l}%)`;
        el.style.setProperty('background', `linear-gradient(135deg, ${color}33, ${color}66)`, 'important');
        const body = el.querySelector('.panel-body');
        if (body) body.style.setProperty('background', `linear-gradient(135deg, ${color}22, ${color}44)`, 'important');
      };
      const onLeave = () => {
        if (!panel.customColor) return;
        this.applyPanelColor(el, panel);
      };
      el.addEventListener('mouseenter', onEnter);
      el.addEventListener('mouseleave', onLeave);
    }

    applyWorldFilter() {
      const mode = this.currentWorld || 'all';
      const filter = (mode === 'all') ? null : (mode === 'music' ? 'music' : (mode === 'school' ? 'school' : (mode === 'life' ? 'home' : mode)));
      document.querySelectorAll('.dynamic-panel').forEach(el => {
        const id = String(el.dataset.panelId);
        const p = this.panels.find(x => String(x.id) === id);
        const tags = p?.tags || [];
        const matches = !filter || tags.includes(filter);
        if (matches) el.classList.remove('panel-filtered');
        else el.classList.add('panel-filtered');
      });
    }


makeDraggable(el) {
  if (window.innerWidth <= 640) return; 

  let startMouseX = 0, startMouseY = 0;
  let startLeft = 0, startTop = 0;
  let lastPersistTs = 0;

  const onMouseDown = (e) => {
    if (el.classList.contains('panel-minimized')) return;
        if (el.classList.contains('panel-flipped')) return; 

    if (e.target.closest('.panel-edit-btn') || e.target.closest('.panel-del-btn') || e.target.closest('.panel-min-btn')) return;

    // For cw panels, don't start dragging when interacting with chat UI/input
    if (el.classList.contains('cw-panel')) {
      if (
        e.target.closest('.cw-root') ||
        e.target.closest('.cw-input') ||
        e.target.closest('.cw-textarea') ||
        e.target.closest('textarea') ||
        e.target.closest('input') ||
        e.target.isContentEditable
      ) {
        return;
      }
    }

    e.preventDefault();
    el.style.cursor = 'grabbing';
    el.style.userSelect = 'none';
    startMouseX = e.clientX;
    startMouseY = e.clientY;
    startLeft = parseFloat(el.style.left || '0');
    startTop = parseFloat(el.style.top || '0');

    document.addEventListener('mousemove', onMouseMove);
    document.addEventListener('mouseup', onMouseUp);
    if (window.panelManager) window.panelManager._isDraggingAny = true;
  };

  const onMouseMove = (e) => {
    e.preventDefault();
    const dx = e.clientX - startMouseX;
    const dy = e.clientY - startMouseY;
    let newLeft = startLeft + dx;
    let newTop = startTop + dy;

    const parentRect = el.offsetParent ? el.offsetParent.getBoundingClientRect() : { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };
    const maxLeft = (parentRect.width || window.innerWidth) - el.offsetWidth;
    const maxTop = (parentRect.height || window.innerHeight) - el.offsetHeight;
    newLeft = Math.max(0, Math.min(newLeft, maxLeft));
    newTop = Math.max(0, Math.min(newTop, maxTop));

    el.style.left = `${newLeft}px`;
    el.style.top = `${newTop}px`;
    // Throttle-persist position to avoid snap-back on refresh
    const now = Date.now();
    if (now - lastPersistTs > 100) {
      const panelId = String(el.dataset.panelId);
      const panel = this.panels.find(p => String(p.id) === panelId);
      if (panel) {
        panel.x = newLeft;
        panel.y = newTop;
        this.touchPanel(panel);
        saveLocal();
      }
      lastPersistTs = now;
    }
  };

  const onMouseUp = () => {
    el.style.cursor = 'grab';
    el.style.removeProperty('user-select');

    const panelId = String(el.dataset.panelId);
    const panel = this.panels.find(p => String(p.id) === panelId);
    if (panel) {
      panel.x = parseFloat(el.style.left) || 0;
      panel.y = parseFloat(el.style.top) || 0;
      panel.w = el.offsetWidth;
      panel.h = el.offsetHeight;
      this.touchPanel(panel);
      stagePanelPatch(panelId, { x: panel.x, y: panel.y, w: panel.w, h: panel.h });
      scheduleCommit(60_000);
    }

    document.removeEventListener('mousemove', onMouseMove);
    document.removeEventListener('mouseup', onMouseUp);
    if (window.panelManager) window.panelManager._isDraggingAny = false;
  };

  el.addEventListener('mousedown', onMouseDown);
}
    
    MakePoopable(el) {
      if (window.innerWidth <= 640) return;

      let startMouseX = 0, startMouseY = 0;
      let startLeft = 0, startTop = 0;

      const onMouseDown = (e) => {
        if (el.classList.contains('panel-minimized')) return;
        if (e.target.closest('.panel-edit-btn') || e.target.closest('.panel-del-btn') || e.target.closest('.panel-min-btn')) return;

        const rect = el.getBoundingClientRect();
        const isNearResizeHandle = e.clientX > rect.right - 20 && e.clientY > rect.bottom - 20;
        if (isNearResizeHandle) return;

        e.preventDefault();
        el.style.cursor = 'grabbing';
        el.style.userSelect = 'none';

        startMouseX = e.clientX;
        startMouseY = e.clientY;

        const parentRect = el.offsetParent ? el.offsetParent.getBoundingClientRect() : { left: 0, top: 0 };
        startLeft = parseFloat(el.style.left || (rect.left - parentRect.left)) || 0;
        startTop  = parseFloat(el.style.top  || (rect.top  - parentRect.top)) || 0;

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      };

      const onMouseMove = (e) => {
        e.preventDefault();
        const dx = e.clientX - startMouseX;
        const dy = e.clientY - startMouseY;
        let newLeft = startLeft + dx;
        let newTop  = startTop  + dy;

        const parentRect = el.offsetParent ? el.offsetParent.getBoundingClientRect() : { left: 0, top: 0, width: window.innerWidth, height: window.innerHeight };
        const maxLeft = (parentRect.width || window.innerWidth) - el.offsetWidth;
        const maxTop  = (parentRect.height || window.innerHeight) - el.offsetHeight;
        newLeft = Math.max(0, Math.min(newLeft, maxLeft));
        newTop  = Math.max(0, Math.min(newTop,  maxTop));

        el.style.left = `${newLeft}px`;
        el.style.top  = `${newTop}px`;
      };

      const onMouseUp = async () => {
        el.style.cursor = 'grab';
        el.style.removeProperty('user-select');

        const panelId = String(el.dataset.panelId);
        const panel = panelManager.panels.find(p => String(p.id) === panelId);
        if (panel) {
          panel.x = parseFloat(el.style.left) || 0;
          panel.y = parseFloat(el.style.top)  || 0;
          panel.w = el.offsetWidth;
          panel.h = el.offsetHeight;
          try { await persistence.savePanel(panel); } catch {}
        }

        document.removeEventListener('mousemove', onMouseMove);
        document.removeEventListener('mouseup', onMouseUp);
      };

      el.addEventListener('mousedown', onMouseDown);
    }

    async minimizePanel(panelElement, opts = { persist: true }) {
      if (!panelElement) {
        console.warn('minimizePanel called with undefined panelElement');
        return;
      }

      if (!panelElement.dataset.prevLeft) {
        panelElement.dataset.prevLeft = panelElement.style.left || '0';
        panelElement.dataset.prevTop = panelElement.style.top || '0';
        panelElement.dataset.prevW = String(panelElement.offsetWidth);
        panelElement.dataset.prevH = String(panelElement.offsetHeight);
      }

      const id = String(panelElement.dataset.panelId);
      const alreadyMin = this.minStack.includes(id);
      if (!alreadyMin && opts?.persist !== false) {
        this.minStack.push(id);
      }
      const index = this.minStack.indexOf(id);

      panelElement.classList.add('panel-minimized');
      panelElement.style.left = '';
      panelElement.style.top = '';
      panelElement.style.width = '100px';
      panelElement.style.height = '56px';
      panelElement.style.left = '-80px';
      panelElement.style.top = (8 + index * 64) + 'px';
      panelElement.addEventListener('click', (e) => {
        e.stopPropagation();
        this.restoreFromMin(panelElement);  
      })
      if (opts?.persist !== false) {
      try { await persistence.minimizePanel(id, true); } catch {}
      }
    }


    async restoreFromMin(panelElement) {
      const id = String(panelElement.dataset.panelId);
      const idx = this.minStack.indexOf(id);
      if (idx !== -1) {
        this.minStack.splice(idx, 1);
      }
      
      this.minStack.forEach((pid, i) => {
        const el = document.querySelector(`.dynamic-panel[data-panel-id="${pid}"]`);
        if (el && el.classList.contains('panel-minimized')) {
          el.style.top = (8 + i * 64) + 'px';
        }
      });

      panelElement.classList.remove('panel-minimized');
      if (panelElement.dataset.prevLeft) {
        panelElement.style.left = panelElement.dataset.prevLeft;
        panelElement.style.top = panelElement.dataset.prevTop || '0px';
        panelElement.style.width = panelElement.dataset.prevW + 'px';
        panelElement.style.height = panelElement.dataset.prevH + 'px';
        delete panelElement.dataset.prevLeft;
        delete panelElement.dataset.prevTop;
        delete panelElement.dataset.prevW;
        delete panelElement.dataset.prevH;
      }
      try { await persistence.minimizePanel(id, false); } catch {}
    }

renderPanels() {
  const container = document.getElementById('panelsContainer');
  const existing = new Map(
    Array.from(container.children).map(el => [String(el.dataset.panelId), el])
  );
  const keep = new Set();

  this.panels.forEach(panel => {
    if (panel.active === false) return;
    const key = String(panel.id);
    keep.add(key);
    const el = existing.get(key);

    // ─── CREATE NEW PANEL ──────────────────────────────────────────────
    if (!el) {
      const newEl = this.createPanelElement(panel);
      this.initializePanelContent(newEl, panel);

      // Type-specific setup BEFORE appending
      if (panel.type === 'external') {
        newEl.className = 'dynamic-panel panel-external';
        Object.assign(newEl.style, {
          border: '.3px solid rgba(255,255,255,.2)',
          borderBottom: 'none',
                    borderLeft: 'none',
                    borderTop:'none',
          boxShadow: 'none',
          borderRadius: '20px',
          background: 'linear-gradient(-100deg, rgba(0,100,80,.3) 0%, transparent 16%)'
        });
      } 

      // Apply hue-rotate before append if color saved
      if (panel.customColor) { try { this.applyPanelColor(newEl, panel); } catch {} }
      // Now append and finalize behaviors
      container.appendChild(newEl);
      this.makeDraggable(newEl);
      if (this.minStack.includes(key)) {
        this.minimizePanel(newEl, { persist: false });
      }
      console.log('[render] create', { id: key });
      return; // done for new panel
    }

    // ─── UPDATE EXISTING PANEL ─────────────────────────────────────────
    // geometry
    el.style.left = `${panel.x || 0}px`;
    el.style.top = `${panel.y || 0}px`;
    if (panel.w) el.style.width = panel.w + 'px';
    if (panel.h) el.style.height = panel.h + 'px';
    // For notes, ensure textarea fills content area after geometry updates
    if (panel.type === 'note') {
      try {
        const contentArea = el.querySelector('.panel-content');
        const ta = contentArea && contentArea.querySelector('.notes-editor');
        if (ta && contentArea) {
          ta.style.height = Math.max(60, contentArea.clientHeight) + 'px';
          ta.style.overflow = 'auto';
        }
      } catch {}
    }

    // title
    const titleEl = el.querySelector('.panel-title');
    if (panel.type === 'external') {
            titleEl.style.fontSize = '.5rem';
      titleEl.style.color = 'lightblue';
      titleEl.style.webkitBackgroundClip = 'none !important';
      titleEl.style.webkitTextFillColor = 'lightblue !important';
    }
    if (titleEl && titleEl.textContent !== (panel.title || '')) {
      titleEl.textContent = panel.title || '';
    }

    // content syncs 
    const contentEl = el.querySelector('.panel-content');
    if (panel.type === 'note') {
      const ta = contentEl.querySelector('.notes-editor');
      if (ta && ta.value !== (panel.content || '')) ta.value = panel.content || '';
    } else if (panel.type === 'external') {

      const iframe = contentEl.querySelector('iframe.external-frame');
      const urlInput = contentEl.querySelector(`#external-url-${panel.id}`);
      if (urlInput && urlInput.value !== (panel.externalUrl || '')) {
        urlInput.value = panel.externalUrl || '';
      }
      if (iframe && iframe.getAttribute('src') !== (panel.externalUrl || '')) {
        iframe.setAttribute('src', panel.externalUrl || '');
      }
      const cfg = contentEl.querySelector('.external-url-config');
      if (cfg) cfg.style.display = panel.externalShowUrl ? 'block' : 'none';
    }

    // Apply custom color if set and ensure hover handlers
    if (el && panel.customColor) {
      this.applyPanelColor(el, panel);
      try { this.attachColorHoverHandlers(el, panel); } catch {}
    }
  });

  // ─── REMOVE STALE NODES ──────────────────────────────────────────────
  Array.from(existing.entries()).forEach(([id, el]) => {
    if (!keep.has(id)) el.remove();
  });

  this.applyWorldFilter();
}
    // Organizer integrations
    getPanelByItemId(itemId) {
      return this.panels.find(p => p.orgId === itemId) || null;
    }
    hasPanelForItem(itemId) {
      const p = this.getPanelByItemId(itemId);
      if (!p) return false;
      return !!document.querySelector(`.dynamic-panel[data-panel-id="${p.id}"]`);
    }
    hidePanelForItem(itemId) {
      const p = this.getPanelByItemId(itemId);
      if (!p) return;
      const el = document.querySelector(`.dynamic-panel[data-panel-id="${p.id}"]`);
      if (el) el.remove();
      p.active = false;
      this.touchPanel(p);
      stagePanelPatch(p.id, { active: false });
      scheduleCommit(60_000);
    }
    showPanelForItem(item) {
      let p = this.getPanelByItemId(item.id);
      if (!p) {
        const tags = (item.tags && item.tags.length) ? [...item.tags] : [];
        this.createNewPanel(item.type, item.name, { source: 'organizer', organizerItemId: item.id, initialTags: tags, chat: item.chat||null });
        return;
      }
      if (p.active !== false && this.hasPanelForItem(item.id)) return;
      p.active = true;
      const el = this.createPanelElement(p);
      this.initializePanelContent(el, p);
      document.getElementById('panelsContainer').appendChild(el);
      this.makeDraggable(el);
      if (this.minStack.includes(String(p.id))) this.minimizePanel(el);
      this.applyWorldFilter();
      this.touchPanel(p);
      stagePanelPatch(p.id, { active: true });
      scheduleCommit(60_000);
    }
    togglePanelFromOrganizer(item) {
      if (this.hasPanelForItem(item.id)) this.hidePanelForItem(item.id);
      else this.showPanelForItem(item);
    }

    async savePanelsToStorage() {
      console.log('[manager] bulk-save-panels', { count: this.panels?.length || 0 });
      try {
        for (const p of this.panels) {
          await persistence.savePanel(p);
        }
      } catch (e) { console.error('[manager] bulk-save-error', { error: String(e && e.message || e) }); }
      return Promise.resolve();
    }

    async loadPanelsFromStorage() {
      this.refreshFromState();
      return Promise.resolve();
    }
  }

  // Global color shim for external/SDK callers
  if (!window.applyPanelColor) {
    window.applyPanelColor = function(panelId, h, s, l) {
      try {
        const pm = window.panelManager;
        if (!pm) return;
        const panel = pm.panels.find(p => String(p.id) === String(panelId));
        if (!panel) return;
        panel.customColor = { h: Number(h)||0, s: Number(s)||0, l: Number(l)||0 };
        const el = document.getElementById(`panel-${panel.id}`);
        if (el && typeof pm.applyPanelColor === 'function') {
          pm.applyPanelColor(el, panel);
        }
      } catch {}
    };
  }

  // ThoughtStream Task Management (like original Thoughtstream)
  class TaskManager {
    constructor() {
