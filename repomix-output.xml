      __ver: SNAP_VER,
      panels: [],
      panelMinStack: [],
      tasks: [],
      events: [],
      organizer: [],
      thoughtstream: [],
      calendar: {},
      chatThreads: {},
      stats: { active: 0, completedToday: 0 },
      clientTs: 0
