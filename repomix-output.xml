<html>
  <body>
    <div class="background-frame-container" id="background-frame-container">
      <iframe
        class="background-frame"
        id="background-frame"
        src="about:blank"
        sandbox="allow-scripts"
        loading="lazy"
      ></iframe>
    </div>

    <div data-app-root>
      <!-- Application UI goes here -->
    </div>
  </body>
</html>
