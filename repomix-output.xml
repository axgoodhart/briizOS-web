  /* Drag wrapper holds the panel and handle; moving this avoids transform jump */
  .cal-drag-wrap { position: fixed; z-index: 200001; perspective: 900px; pointer-events: none;height:50px;width:50px; }
  .cal-drag-wrap.dragging { cursor: grabbing; }
  /* Top-right drag handle appears only when in lay mode + hover */
  .cal-drag-handle {
    position: absolute;
    right: -20px;
    bottom:-20px;
    height: 100%;
    border:1.5px solid rgb(31, 0, 51);
    width: 40px;
