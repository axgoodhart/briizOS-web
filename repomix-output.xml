      if (!mode) return;
      dateMode = mode;
      syncDateModeButtons();
      if (mode === 'due') {
        if (resetReminder) {
          wantsReminderEvent = false;
          hideReminderPrompt();
        }
        if (prompt && type.value !== 'event') {
          showReminderPrompt();
          setReminderChoice('no');
        }
      } else {
        wantsReminderEvent = false;
        hideReminderPrompt();
      }
