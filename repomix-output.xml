async createNewPanel(type = 'note', title = null, options = { source: 'ui' }) {
      const now = Date.now();
      const panel = {
        id: String(++this.panelIdCounter),
        type: type,
        title: title || '',
        content: '',
        tags: Array.isArray(options?.initialTags) ? [...options.initialTags] : [],
        orgId: options?.organizerItemId || null,
        active: true,
        chat: options?.chat || null,
        externalUrl: options?.external?.url || '',
        externalShowUrl: false,
        externalData: null, // Will store data from external app
        subtype: type === 'custom-panel' ? 'ai-chat' : undefined, // Default subtype for custom panels
        customColor: null, // HSL color customization { h, s, l }
        x: 180,
        y: 180,
        createdAt: now,
        updatedAt: now,
        autoHeight: true,
        // jobPanel fields
        jobMessage: options?.jobMessage || null,
        taskId: options?.taskId || null
      };

      const panelElement = this.createPanelElement(panel);
      const container = document.getElementById('panelsContainer');
      container.appendChild(panelElement);

      if (title) {
        // initialize immediately
        this.panels.push(panel);
        this.initializePanelContent(panelElement, panel);
        // Apply saved color immediately on first render
        if (panel.customColor) {
          try { this.applyPanelColor(panelElement, panel); } catch {}
        }
        this.updatePanelTitle(panelElement, title);
        try { await persistence.savePanel(panel); if (panel.type === 'external') { await persistence.flushAll(2000); } } catch {}
        this.makeDraggable(panelElement);
        this.makeResizable(panelElement, panel);
        this.attachEditDrawer(panelElement, panel);
        // Hook hover styling for custom color
        try { this.attachColorHoverHandlers(panelElement, panel); } catch {}
        this.applyWorldFilter();
        // Log to organizer unless created from organizer which will already have an entry
        // jobPanels have their own organizer — skip the main one
          if (panel.type !== 'jobPanel' && options?.source !== 'organizer') {
            try {
              OrganizerStore.load?.();
              const tag = panel.tags?.[0] || null;
              const todayStr = yyyyMMdd(new Date());
              const item = OrganizerStore.create({
                name: title,
                type: panel.type,
                scheduledDate: todayStr,
                tag,
                dateMode: 'created',
                dateValue: todayStr,
                source: { mode: 'panel' },
                panelType: panel.type,
                panelId: panel.id
              });
              this.linkPanelToItem(panel, item);
              OrganizerStore.save?.();
              const modal = document.getElementById('organizer-modal');
              if (modal?.classList.contains('show')) { renderOrganizerList?.(); }
            } catch {}
          } else if (panel.orgId) {
            const it = OrganizerStore.items?.find(i=>i.id===panel.orgId);
            if (it) { it.panelId = panel.id; OrganizerStore.save?.(); }
          }
      } else {
        // Show title input
        this.showTitleInput(panelElement, panel);
      }
    }

    showTitleInput(panelElement, panel) {
      const titleInput = document.createElement('input');
      titleInput.className = 'title-input';
      titleInput.type = 'text';
      titleInput.placeholder = panel.type === 'note' ? 'Note title...' :
                              panel.type === 'timer' ? 'Timer session...' :
                              panel.type === 'chat' ? 'AI Chat...' :
                              panel.type === 'calendar' ? 'Calendar...' :
                              panel.type === 'custom-panel' ? 'AI Assistant...' :
                              'Panel title...';
      titleInput.maxLength = 30;

      panelElement.appendChild(titleInput);
      titleInput.focus();

      let titleSubmitted = false;

      const handleTitleSubmit = async () => {
        if (titleSubmitted) return;
        titleSubmitted = true;

        const title = titleInput.value.trim();
        if (title) {
          panel.w = panelElement.offsetWidth;
          panel.h = panelElement.offsetHeight;
          panel.title = title;
          
          this.panels.push(panel);
          this.updatePanelTitle(panelElement, title);
          this.initializePanelContent(panelElement, panel);
          try { await persistence.savePanel(panel); if (panel.type === 'external') { await persistence.flushAll(2000); } } catch {}
          this.makeDraggable(panelElement);
          this.makeResizable(panelElement, panel);
          this.attachEditDrawer(panelElement, panel);
          this.applyWorldFilter();
          // log to organizer
          try {
            OrganizerStore.load?.();
            const tag = panel.tags?.[0] || null;
            const todayStr = yyyyMMdd(new Date());
            const item = OrganizerStore.create({
              name: title,
              type: panel.type,
              scheduledDate: todayStr,
              tag,
              dateMode: 'created',
              dateValue: todayStr,
              source: { mode: 'panel' },
              panelType: panel.type,
              panelId: panel.id
            });
            this.linkPanelToItem(panel, item);
            OrganizerStore.save?.();
            const modal = document.getElementById('organizer-modal');
            if (modal?.classList.contains('show')) { renderOrganizerList?.(); }
          } catch {}
        } else {
          panelElement.remove();
        }
        titleInput.remove();
      };

      titleInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          handleTitleSubmit();
        }
      });

      titleInput.addEventListener('blur', handleTitleSubmit);
    }

    createPanelElement(panel) {
      const panelElement = document.createElement('div');
      panelElement.className = 'dynamic-panel';
      // Style per panel type
      if (panel.type === 'custom-panel') {
        panelElement.classList.add('cw-panel');
      } else if (panel.type === 'jobPanel') {
        panelElement.classList.add('panel-job');
      } else if (panel.type === 'external') {
        // Naked look for externals on creation
        panelElement.classList.add('panel-external');
      } else {
        panelElement.classList.add('neon-border');
      }

      panelElement.dataset.panelId = panel.id;
      panelElement.style.left = `${panel.x}px`;
      panelElement.style.top = `${panel.y}px`;
      
      if (panel.w) panelElement.style.width = panel.w + 'px';
      if (panel.h) panelElement.style.height = panel.h + 'px';

      panelElement.innerHTML = `
        <div class="panel-buttons-container">
                  <div class="panel-title">${panel.title}</div>

          <button class="panel-edit-btn"></button>
          <button class="panel-min-btn"></button>
          <button class="panel-del-btn"></button>
          <button class="panel-settings-btn"></button>
        </div>
        <button class="panel-url-btn" style="${panel.type==='external' ? '' : 'display:none;'}" onclick="externalManager.toggleUrlConfig('${panel.id}')"></button>
        <div class="panel-body">
          <div class="panel-content">${this.getPanelContent(panel)}</div>
        </div>
        <div class="panel-backside">
          <button class="setting-back-btn" style="display:none;">⊞</button>
          <button class="setting-exit-btn" title="Back to panel">✕</button>
          <div class="setting-icon-header" style="display:none;"></div>

          <div class="settings-grid-section">
            <button class="setting-icon" data-setting="chrome" title="Toggle Chrome">🎨</button>
            <button class="setting-icon" data-setting="lock-dimension" title="Lock Dimensions">🔒</button>
            <button class="setting-icon" data-setting="link" title="Link to Panel">🔗</button>
            <button class="setting-icon" data-setting="format" title="Text Format">📝</button>
            <button class="setting-icon" data-setting="color" title="Panel Color">🌈</button>
            <button class="setting-icon" data-setting="pin" title="Pin Position">📍</button>
          </div>

          <div class="settings-column-section">
            <button class="setting-icon" data-setting="duplicate" title="Duplicate Panel">⎘</button>
            <button class="setting-icon" data-setting="copy-to-chat" title="Copy to AI Chat">💬</button>
            <button class="setting-icon" data-setting="password-lock" title="Password Lock">🔐</button>
          </div>

          <div class="setting-detail-container" style="display:none;">
            <!-- Dynamic content per setting -->
          </div>
        </div>
      `;

      // add custom resize handle and drawer scaffolding
      const resizeHandle = document.createElement('div');
      resizeHandle.className = 'panel-resize-handle';
      panelElement.appendChild(resizeHandle);
      this.makeResizable(panelElement, panel);
      this.attachEditDrawer(panelElement, panel);

      // Edit button functionality
      const editBtn = panelElement.querySelector('.panel-edit-btn');
      editBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!panelElement.dataset.prevW) {
          panelElement.dataset.prevW = String(panelElement.offsetWidth);
          panelElement.dataset.prevH = String(panelElement.offsetHeight);
        }
        this.enterEditMode(panelElement);
      });

      // Delete button functionality (hide if tied to organizer, delete otherwise)
      const delBtn = panelElement.querySelector('.panel-del-btn');
      delBtn.addEventListener('click', async (e) => {
        e.stopPropagation();

        const id = String(panelElement.dataset.panelId);
        const panelRef = this.panels.find(p => String(p.id) === id);
        if (!panelRef) {
          panelElement.remove();
          return;
        }

        if (panelRef.orgId) {
          // Keep underlying data, just hide the window
          panelRef.active = false;
          this.touchPanel(panelRef);
          panelElement.remove();
          try { await persistence.savePanel(panelRef); } catch {}
        } else {
          this.panels = this.panels.filter(p => String(p.id) !== id);
          panelElement.remove();
          try { await persistence.deletePanel(id); } catch {}
        }
        // local refresh only
        this.applyWorldFilter();
      });

      // Minimize button functionality
      const minBtn = panelElement.querySelector('.panel-min-btn');
      minBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (panelElement.classList.contains('panel-minimized')) {
          return;
        } else {
          this.minimizePanel(panelElement);
        }
      });


// Settings button functionality
      const settingsBtn = panelElement.querySelector('.panel-settings-btn');
      settingsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = String(panelElement.dataset.panelId); // This is the corrected line
        this.flipToSettings(id);
      });

      // Attach settings backside functionality
      this.attachSettingsBackside(panelElement, panel);

      return panelElement;
    } 



    touchPanel(panel, extra = {}) {
      if (!panel) return;
      Object.assign(panel, extra);
      panel.updatedAt = Date.now();
    }

    linkPanelToItem(panel, item) {
      panel.orgId = item.id;
      item.panelId = panel.id;
    }

    getPanelContent(panel) {
      switch (panel.type) {
        case 'note':
          return `<textarea class="notes-editor" placeholder="Start typing your notes...">${panel.content}</textarea>`;
        
