  /* Custom resize handle */
  .panel-resize-handle {
    transition: opacity .2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: absolute;
    right: 0px;
    bottom: 0px;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: linear-gradient(to bottom right, transparent 0%, transparent 39%, teal 39.1%, teal 60%, transparent 60.1%, transparent 100%);
    cursor: nwse-resize;
    opacity:1;
    z-index: 3;
  }
.panel-resize-handle:hover{
  transform:scale(3);
  opacity:.8;
}
.panel-resize-handle:active{
transform:scale(2);
background: linear-gradient(to bottom right, transparent 0%, transparent 39%, rgb(11, 228, 196) 39.1%, rgb(11, 228, 196) 60%, transparent 60.1%, transparent 100%);
opacity:1;
}
