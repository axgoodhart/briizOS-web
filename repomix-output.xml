  // Weather Display System (Open-Meteo, no API key)
  class WeatherManager {
    constructor() {
      this.el = document.getElementById('weather-display');
      this.fetchWeather();
      setInterval(() => this.fetchWeather(), 600000); // refresh every 10 min
    }
    wmoGlyph(code, isDay = true) {
      if (code === 0) return isDay ? '☀' : '🌙';
      if (code <= 3) return isDay ? '⛅' : '☾';
      if (code <= 48) return '☁';
      if (code <= 57) return '🌧';
      if (code <= 67) return '🌧';
      if (code <= 77) return '❄';
      if (code <= 82) return '🌧';
      if (code <= 86) return '❄';
      if (code <= 99) return '⛈';
      return '☁';
    }
    async fetchWeather() {
      try {
        const pos = await new Promise((res, rej) =>
          navigator.geolocation.getCurrentPosition(res, rej, { timeout: 8000 })
        );
        const { latitude: lat, longitude: lon } = pos.coords;
        const resp = await fetch(
          `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code,is_day&temperature_unit=fahrenheit`
        );
        const data = await resp.json();
        const temp = Math.round(data.current.temperature_2m);
        const fallbackIsDay = (() => {
          const h = new Date().getHours();
          return h >= 6 && h < 18;
        })();
        const isDay = Number(data?.current?.is_day) === 1 ? true : (Number(data?.current?.is_day) === 0 ? false : fallbackIsDay);
        const glyph = this.wmoGlyph(data.current.weather_code, isDay);
        if (this.el) this.el.textContent = `${glyph} ${temp}°`;
      } catch (e) {
        if (this.el) this.el.textContent = '--°';
      }
    }
  }

  // === Organizer Store (single source of truth for ✦) ===
  const OrganizerStore = {
    get items() {
      return state.organizer;
    },
    load() {
      this.ensureTemporalDefaults();
      return this.items;
    },
    ensureTemporalDefaults() {
      const todayStr = yyyyMMdd(new Date());
      let mutated = false;
      this.items.forEach(it => {
        if (!it) return;
        if (!it.source) {
          it.source = { mode: 'manual' };
          mutated = true;
        }
        if (typeof it.recurrence === 'undefined') {
          it.recurrence = null;
          mutated = true;
        } else if (it.recurrence && typeof it.recurrence === 'object') {
          if (typeof it.recurrence.enabled === 'undefined') {
            it.recurrence.enabled = true;
            mutated = true;
          }
          if ((it.recurrence.type !== 'monthly') && (!Array.isArray(it.recurrence.daysOfWeek) || !it.recurrence.daysOfWeek.length)) {
            const anchorFix = it.recurrence.anchorDate || it.scheduledDate || it.dateValue || todayStr;
            const anchorDate = parseYMDLocal(anchorFix);
            it.recurrence.daysOfWeek = [anchorDate.getDay()];
            mutated = true;
          }
          if (!it.recurrence.endDate) {
            const anchorFix = it.recurrence.anchorDate || it.scheduledDate || it.dateValue || todayStr;
            const anchorDate = parseYMDLocal(anchorFix);
            const end = new Date(anchorDate);
            end.setFullYear(end.getFullYear() + 2);
            it.recurrence.endDate = yyyyMMdd(end);
            mutated = true;
          }
        }
        if (!it.dateMode) {
          if (it.type === 'event') {
            const val = it.scheduledDate || it.due || (it.createdAt ? yyyyMMdd(new Date(it.createdAt)) : todayStr);
            it.dateMode = 'event';
            it.dateValue = val;
            if (!it.scheduledDate && val) it.scheduledDate = val;
            if (!it.due && val) it.due = val;
            mutated = true;
          } else {
            const val = it.dateValue || it.scheduledDate || (it.createdAt ? yyyyMMdd(new Date(it.createdAt)) : todayStr);
            it.dateMode = 'created';
            it.dateValue = val;
            if (!it.scheduledDate && val) it.scheduledDate = val;
            mutated = true;
          }
        } else {
          if (!it.dateValue) {
            const val = it.scheduledDate || it.due || (it.createdAt ? yyyyMMdd(new Date(it.createdAt)) : todayStr);
            if (val) { it.dateValue = val; mutated = true; }
          }
          if (it.dateMode === 'due' && !it.due && it.dateValue) {
            it.due = it.dateValue;
            mutated = true;
          }
          if (it.dateMode === 'created' && !it.scheduledDate && it.dateValue) {
            it.scheduledDate = it.dateValue;
            mutated = true;
          }
        }
        // macOS Calendar sync metadata migration
        if (typeof it.syncSource === 'undefined') {
          it.syncSource = 'briizos';
          mutated = true;
        }
        if (typeof it.macosEventIdentifier === 'undefined') {
          it.macosEventIdentifier = null;
          mutated = true;
        }
        if (typeof it.macosCalendarIdentifier === 'undefined') {
          it.macosCalendarIdentifier = null;
          mutated = true;
        }
        if (typeof it.lastModified === 'undefined') {
          it.lastModified = it.updatedAt || it.createdAt || Date.now();
          mutated = true;
        }
      });
      if (mutated) {
        markDirty();
      }
    },
    async save() {
      try {
        for (const it of this.items) {
          await persistence.saveOrganizerItem(it);
        }
      } catch {}
    },
    upsert(item) {
      const idx = this.items.findIndex(i => i.id === item.id);
      if (idx >= 0) this.items[idx] = item; else this.items.push(item);
      this.save();
    },
    archiveItem(id) {
      const idx = this.items.findIndex(i => i.id === id);
      if (idx === -1) return;
      const [removed] = this.items.splice(idx, 1);
      OrganizerArchive.add(removed);
      this.save();
      try { persistence.deleteOrganizerItem(removed.id); } catch {}
      if (removed?.panelId && window.panelManager) {
        const pm = window.panelManager;
        pm.panels = pm.panels.filter(p => p.id !== removed.panelId);
        pm.savePanelsToStorage();
      }
    },
    create({ name, type='task', scheduledDate=null, due=null, tag=null, chat=null, external=null, dateMode=null, dateValue=null, source=null, reminderEventId=null, panelType=null, panelId=null, recurrence=null, syncSource='briizos', macosEventIdentifier=null, macosCalendarIdentifier=null, timeStart=null, duration=null }) {
      const now = Date.now();
      const fallbackDate = dateValue || scheduledDate || due || yyyyMMdd(new Date(now));
      const resolvedMode = dateMode || (type === 'event' ? 'event' : 'created');

      // Calculate end time if both timeStart and duration are provided
      let endTime = null;
      if (timeStart && duration) {
        endTime = timeStart + duration;
      }

      const item = {
        id: 'itm_' + now + '_' + Math.random().toString(36).slice(2,7),
        type, title: name || '(untitled)', name: name || '(untitled)', body: '',
        createdAt: now, updatedAt: now,
        scheduledDate, start: timeStart, end: endTime, due, duration: duration, completedAt: null,
        status: 'todo', priority: 'auto',
        tags: tag ? [tag] : [], groupMemberships: [], inStream: false,
        attachments: [], source: source || { mode: 'manual' }, links: [],
        panelType: panelType || null, panelId: panelId || null, accent: null, owner: 'User1', visibility: 'private',
        chat, // { provider, model }
        external,
        dateMode: resolvedMode,
        dateValue: fallbackDate,
        reminderEventId: reminderEventId || null,
        recurrence: recurrence ? { ...recurrence } : null,
        // macOS Calendar sync metadata
        syncSource: syncSource,
        macosEventIdentifier: macosEventIdentifier,
        macosCalendarIdentifier: macosCalendarIdentifier,
        lastModified: now,
        history: []
      };
      if (!item.scheduledDate && resolvedMode === 'created') {
        item.scheduledDate = fallbackDate;
      }
      if (!item.due && resolvedMode === 'due') {
        item.due = fallbackDate;
      }
      this.items.push(item); this.save(); return item;
    },
    toggleDone(id) {
      const it = this.items.find(i => i.id === id);
      if (!it) return;
      const now = Date.now();
      if (it.completedAt) { it.completedAt = null; it.status = 'todo'; }
      else { it.completedAt = now; it.status = 'done'; }
      it.updatedAt = now;
      it.lastModified = now;
      this.save();
    }
  };
