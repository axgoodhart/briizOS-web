  // Archive Manager (local backups + basic restore/export/import)
  class ArchiveManager {
    constructor() {
      this.selectedKey = null;
      this.filterKey = 'glOS.archive.filters';
      this.filters = this.loadFilters();
      // Apply filters and background on init
      this.applyFilters();
      this.applyBackground();
    }
    open() {
      this.refreshList();
      const wrap = document.getElementById('archive-modal');
      wrap.classList.add('show');
      wrap.setAttribute('aria-hidden','false');
      this.applyFilters();
      this.bindFilterControls();
    }
    close() {
      const wrap = document.getElementById('archive-modal');
      wrap.classList.remove('show');
      wrap.setAttribute('aria-hidden','true');
      this.unbindFilterControls();
    }
    loadFilters(){
      try { return JSON.parse(localStorage.getItem(this.filterKey)||'null') || { b:100,c:100,s:100,h:0,sp:0,inv:false }; } catch { return { b:100,c:100,s:100,h:0,sp:0,inv:false }; }
    }
    saveFilters(){ try { localStorage.setItem(this.filterKey, JSON.stringify(this.filters)); } catch {} }
    filterCss(){
      const f = this.filters; const parts = [
        `brightness(${f.b}%)`, `contrast(${f.c}%)`, `saturate(${f.s}%)`, `hue-rotate(${f.h}deg)`, `sepia(${f.sp}%)`
      ]; if (f.inv) parts.push('invert(1)'); return parts.join(' ');
    }
    applyFilters(){
      const html = document.documentElement;
      html.style.filter = this.filterCss();
      // Also apply filters to background container
      const container = document.getElementById('bg-panel-container');
      if (container) container.style.filter = this.filterCss();
    }
    openFilters(){
      const wrap = document.getElementById('arch-filters-modal');
      if (!wrap) return;
      this.bindFilterControls();
      wrap.classList.add('active');
      wrap.setAttribute('aria-hidden','false');
      const panel = wrap.querySelector('.archive-panel');
      if (panel) {
        panel.classList.remove('fade-in');
        setTimeout(()=> panel.classList.add('fade-in'), 20);
      }
      this.syncFilterUI();
    }
    closeFilters(){
      const wrap = document.getElementById('arch-filters-modal');
      if (!wrap) return;
      const panel = wrap.querySelector('.archive-panel');
      if (panel) panel.classList.remove('fade-in');
      setTimeout(()=>{
        wrap.classList.remove('active');
        wrap.setAttribute('aria-hidden','true');
      }, 200);
      this.unbindFilterControls();
    }
    syncFilterUI(){
      const f=this.filters; const set=(id,val,sfx='')=>{ const el=document.getElementById(id); if(el) el.value=String(val); const vd=document.getElementById(id+'-val'); if(vd) vd.textContent=sfx?`${val}${sfx}`:String(val); };
      set('af-brightness',f.b,'%'); set('af-contrast',f.c,'%'); set('af-saturate',f.s,'%'); set('af-hue',f.h,'°'); set('af-sepia',f.sp,'%'); const inv=document.getElementById('af-invert'); if(inv) inv.checked=!!f.inv;
      const bg=document.getElementById('af-background'); if(bg) bg.value=this.loadBackground();
    }
    loadBackground(){
      try { return localStorage.getItem('glOS.background') || ''; } catch { return ''; }
    }
    saveBackground(val){
      try { localStorage.setItem('glOS.background', val); } catch {}
    }
    applyBackground(){
      const mainbg = document.body;
      const frame = document.getElementById('bg-panel-frame');
      if (!frame) return;
      const DEFAULT_BG = 'assets/backgrounds/default-gradient.html';
      const bg = this.loadBackground();
      frame.src = bg && bg.trim() !== '' ? bg : DEFAULT_BG;
      // Apply current filters to background container
      const container = document.getElementById('bg-panel-container');
      if (container) container.style.filter = this.filterCss();
      mainbg.style.background = 'none';

      // Reset calendar position first
      const calendar = document.getElementById('cal-daily');
      if (calendar) {
        // Reset to default styles
        calendar.style.position = '';
        calendar.style.transformOrigin = '';
        calendar.style.right = '';
        calendar.style.transform = '';
        calendar.style.top = '';

        // Apply custom position for 24h background option
        if (frame.src.endsWith('assets/backgrounds/24h.html')) {
          calendar.style.position = 'absolute';
          calendar.style.transformOrigin = 'top';
          calendar.style.right = '50vw';
          calendar.style.transform = 'translateX(50%)';
          calendar.style.top = '30vh';
        }
        // You can add more background-specific customizations here
        // For example:
        // if (frame.src.endsWith('assets/backgrounds/purdots.png')) {
        //   calendar.style.color = 'white';
        //   calendar.style.textShadow = '2px 2px 4px rgba(0,0,0,0.8)';
        // }
      }
    }
    bindFilterControls(){
      // Bind filter control inputs (sliders, reset, invert). Button and close/done handled globally.
      const reset=document.getElementById('af-reset'); if(reset) reset.onclick=()=>{ this.filters={ b:100,c:100,s:100,h:0,sp:0,inv:false }; this.saveFilters(); this.syncFilterUI(); this.applyFilters(); };
      const bindRange=(id,key)=>{ const el=document.getElementById(id); if(!el) return; el.oninput=()=>{ const v=Number(el.value||0); this.filters[key]=v; this.saveFilters(); const vd=document.getElementById(id+'-val'); if(vd) vd.textContent=(id==='af-hue')?`${v}°`:`${v}%`; this.applyFilters(); }; };
      ['af-brightness','af-contrast','af-saturate','af-hue','af-sepia'].forEach((id,i)=> bindRange(id, ['b','c','s','h','sp'][i]));
      const inv=document.getElementById('af-invert'); if(inv) inv.onchange=()=>{ this.filters.inv=!!inv.checked; this.saveFilters(); this.applyFilters(); };
      const bg=document.getElementById('af-background'); if(bg) bg.onchange=()=>{ this.saveBackground(bg.value); this.applyBackground(); };
    }
    unbindFilterControls(){
      // Unbind only control inputs we attach here. Button and close/done remain globally bound.
      const reset=document.getElementById('af-reset'); if(reset) reset.onclick=null;
      ['af-brightness','af-contrast','af-saturate','af-hue','af-sepia'].forEach(id=>{ const el=document.getElementById(id); if(el) el.oninput=null; });
      const inv=document.getElementById('af-invert'); if(inv) inv.onchange=null;
      const bg=document.getElementById('af-background'); if(bg) bg.onchange=null;
    }
    listLocalBackups() {
      const keys = Object.keys(localStorage).filter(k => k.startsWith('glOS.state.backup.'));
      const list = keys.map(k => {
        let data = null; let clientTs = 0; let when = 0;
        try { data = JSON.parse(localStorage.getItem(k) || 'null'); } catch {}
        clientTs = Number(data?.clientTs || 0);
        const tsFromKey = Number(k.split('.').pop());
        when = Number.isFinite(tsFromKey) ? tsFromKey : (clientTs || 0);
        return { key:k, source:'local-backup', clientTs, when, dataExists: !!data };
      });
      // include current local state as an item
      try {
        const currentRaw = localStorage.getItem('glOS.state.v1');
        if (currentRaw) {
          const cur = JSON.parse(currentRaw);
          list.unshift({ key:'glOS.state.v1', source:'local-current', clientTs:Number(cur?.clientTs||0), when:Number(cur?.clientTs||0), dataExists:true });
        }
      } catch {}
      return list.sort((a,b)=> (b.when||0)-(a.when||0));
    }
    refreshList(){
      const tbody = document.getElementById('arch-tbody');
      tbody.innerHTML = '';
      const items = this.listLocalBackups();
      const fmt = (ts)=> ts ? new Date(ts).toLocaleString() : '';
      items.forEach((it, idx)=>{
        const tr = document.createElement('tr');
        tr.dataset.key = it.key;
        tr.innerHTML = `<td><input type="radio" name="arch-sel"></td><td>${fmt(it.when)} <small>${it.key}</small></td><td>${it.source}</td><td>${it.clientTs||''}</td>`;
        tr.addEventListener('click', ()=>{
          this.selectedKey = it.key; this.syncSelection();
        });
        tbody.appendChild(tr);
        if (idx===0 && !this.selectedKey) { this.selectedKey = it.key; }
      });
      this.syncSelection();
    }
    syncSelection(){
      const rows = Array.from(document.querySelectorAll('#arch-tbody tr'));
      rows.forEach(r=>{
        const sel = r.querySelector('input[type="radio"]');
        sel.checked = (r.dataset.key === this.selectedKey);
        r.style.background = sel.checked ? 'rgba(255, 217, 0, 0.1)' : '';
      });
      const msg = document.getElementById('arch-msg');
      msg.textContent = this.selectedKey ? `Selected: ${this.selectedKey}` : 'Select a snapshot';
    }
    loadSnapshot(key){
      if (key === 'glOS.state.v1') {
        try { return JSON.parse(localStorage.getItem('glOS.state.v1')||'null'); } catch { return null; }
      }
      try { return JSON.parse(localStorage.getItem(key)||'null'); } catch { return null; }
    }
    viewSelected(){
      const key = this.selectedKey; if(!key) return;
      const data = this.loadSnapshot(key);
      const blob = new Blob([JSON.stringify(data, null, 2)], { type:'application/json' });
      const url = URL.createObjectURL(blob);
      window.open(url, '_blank');
      setTimeout(()=>URL.revokeObjectURL(url), 5_000);
    }
    exportSelected(){
      const key = this.selectedKey; if(!key) return;
      const data = this.loadSnapshot(key);
      const blob = new Blob([JSON.stringify(data, null, 2)], { type:'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `${key.replace(/[^a-z0-9_.-]/gi,'_')}.json`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(()=>URL.revokeObjectURL(url), 5_000);
    }
    makeCopy(){
      const key = this.selectedKey; if(!key) return;
      const data = this.loadSnapshot(key); if(!data) return;
      try {
        const copyKey = `glOS.state.backup.${Date.now()}`;
        localStorage.setItem(copyKey, JSON.stringify(data));
        this.refreshList();
      } catch {}
    }
    restoreSelected(){
      const key = this.selectedKey; if(!key) return;
      const data = this.loadSnapshot(key); if(!data) return;
      // Backup current
      backupLocalState();
      // Replace local state entirely, respecting normalization
      try {
        const normalized = normalizeStateShape(data);
        Object.assign(state, normalized);
        ensureModelTimestamps();
        // Refresh UIs
        if (panelManager) panelManager.refreshFromState?.();
        if (taskManager) taskManager.refreshFromState?.();
        if (calendarManager) calendarManager.refreshFromState?.();
        // Do not write cache directly on restore; checkpoint to cloud, let onSnapshot repopulate cache
        checkpoint(true);
        const msg = document.getElementById('arch-msg');
        msg.textContent = 'Restore pushed to cloud; cache will refresh';
      } catch (e) {
        const msg = document.getElementById('arch-msg');
        msg.textContent = 'Restore failed';
      }
    }
    importPanelsFromFile(file){
      if(!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(reader.result);
          const panels = Array.isArray(data?.panels) ? data.panels
            : Array.isArray(data) ? data : [];
          if (panels.length) {
            state.panels.push(...panels.map(p=> ({...p, id: p.id || ('p_'+Math.random().toString(36).slice(2,7)) })));
            saveLocal(); markDirty(); checkpoint(true);
            if (panelManager) panelManager.refreshFromState?.();
            document.getElementById('arch-msg').textContent = `Imported ${panels.length} panel(s)`;
          } else {
            document.getElementById('arch-msg').textContent = 'No panels found in file';
          }
        } catch {
          document.getElementById('arch-msg').textContent = 'Import failed: invalid JSON';
        }
      };
      reader.readAsText(file);
    }
  }

  // External Panel Management System  
  class ExternalManager {
    constructor() {
      this.panels = new Map(); // panelId -> { iframe, messageHandlers }
      this.setupGlobalMessageHandler();
    }

    getPanelManager(fallback) {
      return fallback || window.panelManager || null;
    }

    setupGlobalMessageHandler() {
      window.addEventListener('message', (event) => {
        // Handle messages from external apps
        this.handleExternalMessage(event);
      });
    }

    initializeExternalPanel(panelId, panelElement, managerRef) {
      const iframe = panelElement.querySelector(`#external-frame-${panelId}`);
      const urlInput = panelElement.querySelector(`#external-url-${panelId}`);
      const hostManager = this.getPanelManager(managerRef);
      
      if (iframe) {
        // Store panel reference
        this.panels.set(panelId, { 
          iframe, 
          panelElement,
          messageHandlers: new Set()
        });

        // Setup iframe load handlers
        iframe.addEventListener('load', () => {
          this.onIframeLoaded(panelId);
        });

        iframe.addEventListener('error', () => {
          this.onIframeError(panelId);
        });
      }

      if (urlInput && hostManager) {
        // Replace listener with debounced persistence-backed save
        const newInput = urlInput.cloneNode(true);
        urlInput.parentNode.replaceChild(newInput, urlInput);
        let saveTimer = null;
        newInput.addEventListener('input', (e) => {
          const panel = hostManager.panels.find(p => String(p.id) === String(panelId));
          if (panel) {
            panel.externalUrl = e.target.value;
            clearTimeout(saveTimer);
            saveTimer = setTimeout(async () => {
              try { await persistence.savePanel(panel); } catch {}
            }, 500);
          }
        });
      }
    }

async    toggleUrlConfig(panelId) {
      const manager = this.getPanelManager();
      const panel = manager?.panels.find(p => String(p.id) === String(panelId));
      if (!panel || !manager) return;
      panel.externalShowUrl = !panel.externalShowUrl;
      try { await persistence.savePanel(panel); } catch {}
      const el = document.querySelector(`[data-panel-id="${panelId}"] .external-url-config`);
      if (el) el.style.display = panel.externalShowUrl ? 'block' : 'none';
    }

    async loadExternalApp(panelId) {
      const urlInput = document.getElementById(`external-url-${panelId}`);
      const manager = this.getPanelManager();
      const panel = manager?.panels.find(p => String(p.id) === String(panelId));
      const url = urlInput?.value?.trim() || panel?.externalUrl || '';

      if (!url) {
        this.showError(panelId, 'Please enter a valid URL');
        return;
      }

      // Validate URL format
      try {
        new URL(url);
      } catch (e) {
        this.showError(panelId, 'Please enter a valid URL (including https://)');
        return;
      }

      // Update panel data
      if (panel && manager) {
        panel.externalUrl = url;
        try { await persistence.savePanel(panel); await persistence.flushAll(2000); } catch {}

        // Refresh panel content
        const panelElement = document.querySelector(`[data-panel-id="${panelId}"]`);
        if (panelElement) {
          const contentDiv = panelElement.querySelector('.panel-content');
          contentDiv.innerHTML = manager.getPanelContent(panel);
          this.initializeExternalPanel(panelId, panelElement, manager);
        }
      }
    }

    onIframeLoaded(panelId) {
      const panelData = this.panels.get(panelId);
      if (!panelData) return;

      // Send initial handshake message to external app
      this.sendMessageToExternal(panelId, {
        type: 'briizOS.init',
        panelId: panelId,
        timestamp: Date.now(),
        capabilities: ['data-exchange', 'notifications', 'resize']
      });

      console.log(`External app loaded in panel ${panelId}`);
    }

    onIframeError(panelId) {
      this.showError(panelId, 'Failed to load external application. Please check the URL and try again.');
    }

    sendMessageToExternal(panelId, message) {
      const panelData = this.panels.get(panelId);
      if (!panelData || !panelData.iframe) return;

      try {
        panelData.iframe.contentWindow.postMessage({
          ...message,
          source: 'briizOS',
          panelId: panelId
        }, '*');
      } catch (error) {
        console.warn('Failed to send message to external app:', error);
      }
    }

    handleExternalMessage(event) {
      // Basic security check - only handle messages with proper structure
      if (!event.data || typeof event.data !== 'object') return;
      if (!event.data.source || !event.data.panelId) return;

      const { panelId, type, data } = event.data;
      const panelData = this.panels.get(panelId);
      
      if (!panelData) return;

      // Verify message is from the correct iframe
      if (event.source !== panelData.iframe.contentWindow) return;

      switch (type) {
        case 'briizOS.ready':
          this.handleAppReady(panelId, data);
          break;

        case 'briizOS.resize':
          this.handleResizeRequest(panelId, data);
          break;

        case 'briizOS.notification':
          this.handleNotification(panelId, data);
          break;

        case 'briizOS.data.save':
          this.handleDataSave(panelId, data);
          break;

        case 'briizOS.data.load':
          this.handleDataLoad(panelId, data);
          break;

        case 'briizOS.setColor':
          this.handleSetColor(panelId, data);
          break;

        // AI Integration
        case 'briizOS.ai.query':
          this.handleAIQuery(panelId, data, event.data.requestId);
          break;

        case 'briizOS.ai.action':
          this.handleAIAction(panelId, data, event.data.requestId);
          break;

        case 'briizOS.ai.subscribe':
          this.handleAISubscription(panelId, data);
          break;

        case 'briizOS.ai.context':
          this.handleAIContextRequest(panelId, data, event.data.requestId);
          break;

        default:
          console.log('Unknown external message type:', type, data);
      }
    }

    handleAppReady(panelId, data) {
      console.log(`External app ready in panel ${panelId}:`, data);
      
      // Send any saved data to the external app
      const manager = this.getPanelManager();
      const panel = manager?.panels.find(p => String(p.id) === String(panelId));
      if (panel && panel.externalData) {
        this.sendMessageToExternal(panelId, {
          type: 'briizOS.data.restore',
          data: panel.externalData
        });
      }
    }

    handleResizeRequest(panelId, data) {
      const panelData = this.panels.get(panelId);
      if (!panelData) return;

      const { width, height } = data;
      if (width && height) {
        panelData.panelElement.style.width = width + 'px';
        panelData.panelElement.style.height = height + 'px';
        
        // Update panel data
        const manager = this.getPanelManager();
        const panel = manager?.panels.find(p => String(p.id) === String(panelId));
        if (panel && manager) {
          panel.w = width;
          panel.h = height;
          try { persistence.savePanel(panel); } catch {}
        }
      }
    }

    handleNotification(panelId, data) {
      // Create a floating notification
      const notification = document.createElement('div');
      notification.className = 'floating-task';
      notification.style.position = 'fixed';
      notification.style.top = '20px';
      notification.style.right = '20px';
      notification.style.zIndex = '10000';
      notification.textContent = data.message || 'Notification from external app';
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.remove();
      }, data.duration || 3000);
    }

    async handleDataSave(panelId, data) {
      const manager = this.getPanelManager();
      const panel = manager?.panels.find(p => String(p.id) === String(panelId));
      if (panel && manager) {
        panel.externalData = data;
        try { await persistence.savePanel(panel); } catch {}
        
        // Acknowledge save
        this.sendMessageToExternal(panelId, {
          type: 'briizOS.data.saved',
          success: true
        });
      }
    }

    handleDataLoad(panelId, data) {
      const manager = this.getPanelManager();
      const panel = manager?.panels.find(p => String(p.id) === String(panelId));
      const responseData = panel && panel.externalData ? panel.externalData : null;

      this.sendMessageToExternal(panelId, {
        type: 'briizOS.data.loaded',
        data: responseData,
        requestId: data.requestId
      });
    }

    handleSetColor(panelId, data) {
      const { hue, saturation, lightness } = data;
      const manager = this.getPanelManager();
      const panel = manager?.panels.find(p => String(p.id) === String(panelId));

      if (panel && window.applyPanelColor) {
        window.applyPanelColor(panel.id, hue, saturation, lightness);
      }
    }

    // ===== AI INTEGRATION HANDLERS =====

    async handleAIQuery(panelId, data, requestId) {
      const { query, context } = data;

      // Use ChatAPI directly to generate a response
      if (window.ChatAPI) {
        try {
          const api = new ChatAPI();
          const baseMessages = [
            { role: 'user', content: query }
          ];
          let fullText = '';

          for await (const chunk of api.streamChat(baseMessages)) {
            if (typeof chunk === 'object' && chunk.type === 'tool_call') {
              // Ignore tool calls in external bridge for now; return text only
              continue;
            }
            if (typeof chunk === 'string') {
              fullText += chunk;
            }
          }

          this.sendMessageToExternal(panelId, {
            type: 'briizOS.ai.response',
            data: fullText || '',
            requestId: requestId
          });
        } catch (error) {
          this.sendMessageToExternal(panelId, {
            type: 'briizOS.ai.error',
            data: { error: error.message },
            requestId: requestId
          });
        }
      } else {
        this.sendMessageToExternal(panelId, {
          type: 'briizOS.ai.error',
          data: { error: 'Chat API not available' },
          requestId: requestId
        });
      }
    }

    async handleAIAction(panelId, data, requestId) {
      const { action, params } = data;

      // Execute through BriizOSTools
      if (window.briizTools && window.briizTools.tools[action]) {
        try {
          const result = await window.briizTools.execute(action, params);

          this.sendMessageToExternal(panelId, {
            type: 'briizOS.ai.actionComplete',
            data: result,
            requestId: requestId
          });
        } catch (error) {
          this.sendMessageToExternal(panelId, {
            type: 'briizOS.ai.error',
            data: { error: error.message },
            requestId: requestId
          });
        }
      } else {
        this.sendMessageToExternal(panelId, {
          type: 'briizOS.ai.error',
          data: { error: `Unknown action: ${action}` },
          requestId: requestId
        });
      }
    }

    handleAISubscription(panelId, data) {
      const { eventType } = data;

      // Store subscription
      const panelData = this.panels.get(panelId);
      if (!panelData.subscriptions) {
        panelData.subscriptions = new Set();
      }
      panelData.subscriptions.add(eventType);

      // Acknowledge subscription
      this.sendMessageToExternal(panelId, {
        type: 'briizOS.ai.subscribed',
        data: { eventType }
      });
    }

    handleAIContextRequest(panelId, data, requestId) {
      // Get current context
      const context = window.contextProvider?.getContext();

      this.sendMessageToExternal(panelId, {
        type: 'briizOS.ai.contextData',
        data: context,
        requestId: requestId
      });
    }

    // Event broadcasting to subscribed panels
    broadcastAIEvent(eventType, eventData) {
      this.panels.forEach((panelData, panelId) => {
        if (panelData.subscriptions && panelData.subscriptions.has(eventType)) {
          this.sendMessageToExternal(panelId, {
            type: 'briizOS.ai.event',
            data: {
              eventType,
              ...eventData
            }
          });
        }
      });
    }

    showError(panelId, message) {
      const panelElement = document.querySelector(`[data-panel-id="${panelId}"]`);
      if (!panelElement) return;

      const contentDiv = panelElement.querySelector('.panel-content');
      const errorDiv = document.createElement('div');
      errorDiv.className = 'external-error';
      errorDiv.textContent = message;
      
      // Replace just the iframe/loading content, keep URL config
      const existingError = contentDiv.querySelector('.external-error');
      if (existingError) {
        existingError.remove();
      }
      
      contentDiv.appendChild(errorDiv);
    }

    // Public API for external apps to use
    getAPIInterface(panelId) {
      return {
        // Send data to briizOS
        saveData: (data) => this.sendMessageToExternal(panelId, {
          type: 'briizOS.data.save',
          data: data
        }),
        
        // Load data from briizOS
        loadData: () => this.sendMessageToExternal(panelId, {
          type: 'briizOS.data.load'
        }),
        
        // Show notification
        notify: (message, duration = 3000) => this.sendMessageToExternal(panelId, {
          type: 'briizOS.notification',
          data: { message, duration }
        }),
        
        // Request panel resize
        resize: (width, height) => this.sendMessageToExternal(panelId, {
          type: 'briizOS.resize',
          data: { width, height }
        }),
        
        // Signal that app is ready
        ready: (appInfo = {}) => this.sendMessageToExternal(panelId, {
          type: 'briizOS.ready',
          data: appInfo
        })
      };
    }
  }

  // Authentication System
  class AuthManager {
    constructor() {
      this.init();
    }

    init() {
      this.setupEventListeners();
      this.checkAuthState(); 
    }

    setupEventListeners() {
      document.getElementById('login-btn').addEventListener('click', () => {
        this.handleLogin();
      });

      document.getElementById('password-input').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          this.handleLogin();
        }
      });
    }

    async handleLogin() {
      const email = document.getElementById('username-input').value.trim();
      const password = document.getElementById('password-input').value.trim();

      if (!email || !password) {
        alert('Please enter both email and password.');
        return;
      }

      try {
        let userCredential;
        try {
          userCredential = await signInWithEmailAndPassword(auth, email, password);
        } catch (error) {
          if (error.code === 'auth/user-not-found') {
            userCredential = await createUserWithEmailAndPassword(auth, email, password);
          } else {
            throw error;
          }
        }

        currentUser = userCredential.user.uid;
        this.hideLogin();
        this.initializeApp();
        this.startAutoSync();
      } catch (error) {
        console.error('Login error:', error);
        alert('Login failed: ' + error.message);
      }
    }

    checkAuthState() {
      onAuthStateChanged(auth, (user) => {
        if (DEV_SAFE_MODE) {
          this.hideLogin();
          currentUser = null; // stay local-only
          this.initializeApp();
          return;
        }
        
        if (user) {
          currentUser = user.uid;
          this.hideLogin();
          this.initializeApp();
          this.startAutoSync();
        } else {
          setTimeout(() => {
                      this.showLogin();  }, 1000); 
        }
      });
    } 

    showLogin() {
      document.getElementById('login-overlay').style.display = 'flex';
                  document.getElementById('login-overlay').style.opacity = '1';

    }

    hideLogin() {
           document.getElementById('login-overlay').style.opacity = '0';
  document.getElementById('login-overlay').style.display = 'none'; 

    }
 
    startAutoSync() {
      if (DEV_SAFE_MODE || !deprecSync) return;
      
      if (autoSyncInterval) clearInterval(autoSyncInterval);
      autoSyncInterval = setInterval(async () => {
        if (currentUser) {
          try {
            await checkpoint();
          } catch (error) {
            console.error('Auto-sync failed:', error);
          }
        }
      }, 30000); // Every 30 seconds
    }

    async initializeApp() {
      // Ensure managers are initialized before using them
      if (!window.panelManager) {
        if (window._initManagers) {
          window._initManagers();
        }
      }

      // Now safely refresh from state
      if (window.panelManager) window.panelManager.refreshFromState?.();
      if (window.taskManager) window.taskManager.refreshFromState?.();
      if (window.calendarManager) window.calendarManager.refreshFromState?.();
    }
  }

