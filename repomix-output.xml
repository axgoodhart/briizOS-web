  const taskAdapter = {
    normalizeOnRead(id, data) {
      return {
        id: String(id),
        type: data.type || 'task',
        title: data.title || data.text || data.name || data.message || '',
        status: (data.completed || data.completedAt) ? 'completed' : (data.status || 'pending'),
