    initializePanelContent(panelElement, panel) {
      if (panel.type === 'note') {
        const textarea = panelElement.querySelector('.notes-editor');
        const contentEl = panelElement.querySelector('.panel-content');
        const syncTextareaToContent = () => {
          if (!textarea || !contentEl) return;
          const avail = Math.max(60, contentEl.clientHeight);
          textarea.style.height = avail + 'px';
          textarea.style.overflow = 'auto';
        };
        // Ensure properties exist
        if (typeof panel.expansionCount !== 'number') panel.expansionCount = 0;
        if (typeof panel.autoHeight !== 'boolean') panel.autoHeight = true;

        // Base size relative to window if no saved dimensions
        const applyBaseSizeFromWindow = (persist = true) => {
          if (panel.w && panel.h) return; // respect saved sizes
          const baseW = Math.max(280, Math.floor(window.innerWidth * 0.28));
          const baseH = Math.max(500, Math.floor(panelElement.style.height * 0.30));
          panelElement.style.width = baseW + 'px';
          panelElement.style.height = (baseH + 60) + 'px';
          textarea.style.height = baseH + 'px';
          if (persist) {
            panel.w = baseW; panel.h = baseH + 60;
            this.touchPanel(panel, { w: panel.w, h: panel.h });
            stagePanelPatch(panel.id, { w: panel.w, h: panel.h });
            scheduleCommit(60_000);
            try { persistence.savePanel(panel); } catch {}
          }
        };

        applyBaseSizeFromWindow(false);

        // Responsive update when window resizes only if not expanded yet
        const onWinResize = () => {
          if (panel.expansionCount > 0 || panel.autoHeight === false) return;
          applyBaseSizeFromWindow(false);
        };
        window.addEventListener('resize', onWinResize);

        // Resize/expand behavior
        const ensureScrollPosition = () => {
          // Outside edit mode: show top; In edit mode: keep bottom at ~60% height
          if (panelElement.classList.contains('editing')) {
            const target = Math.max(0, textarea.scrollHeight - Math.floor(textarea.clientHeight * 0.60));
            textarea.scrollTop = target;
          } else {
            textarea.scrollTop = 0;
          }
        };

        const maybeExpandOnOverflow = () => {
          // Only expand if content exceeds current textbox height
          const overflow = textarea.scrollHeight > textarea.clientHeight + 2;
          if (!overflow) return;

          if (panel.expansionCount === 0) {
            // 1st expansion: 1.5x height
            const newTaH = Math.floor(textarea.clientHeight * 1.5);
            textarea.style.height = newTaH + 'px';
            const newPanelH = newTaH + 60;
            panelElement.style.height = newPanelH + 'px';
            panel.expansionCount = 1;
            panel.h = newPanelH;
            panel.autoHeight = false; // lock size after manual expansions
            this.touchPanel(panel, { h: panel.h, autoHeight: false, expansionCount: panel.expansionCount });
            stagePanelPatch(panel.id, { h: panel.h, autoHeight: false, expansionCount: panel.expansionCount });
            scheduleCommit(60_000);
            try { persistence.savePanel(panel); } catch {}
          } else if (panel.expansionCount === 1) {
            // 2nd expansion: +1.25x height and double width
            const newTaH = Math.floor(textarea.clientHeight * 1.25);
            const newPanelH = newTaH + 60;
            const newPanelW = Math.min(panelElement.offsetWidth * 2, Math.max(320, window.innerWidth - 40));
            textarea.style.height = newTaH + 'px';
            panelElement.style.height = newPanelH + 'px';
            panelElement.style.width = newPanelW + 'px';
            panel.expansionCount = 2;
            panel.h = newPanelH; panel.w = newPanelW;
            panel.autoHeight = false;
            this.touchPanel(panel, { h: panel.h, w: panel.w, autoHeight: false, expansionCount: panel.expansionCount });
            stagePanelPatch(panel.id, { h: panel.h, w: panel.w, autoHeight: false, expansionCount: panel.expansionCount });
            scheduleCommit(60_000);
            try { persistence.savePanel(panel); } catch {}
          } else {
            // 3rd+ time: no size change; maintain scroll behavior
          }
        };

        const hydrateInitialHeights = () => {
          if (panel.h && panel.w) {
            // Respect persisted size; set textarea to fit panel minus chrome
            syncTextareaToContent();
          } else {
            // Use base sizing from window
            applyBaseSizeFromWindow(false);
          }
          ensureScrollPosition();
        };

        // Event wiring
        textarea.addEventListener('input', () => {
          panel.content = textarea.value;
          stagePanelPatch(panel.id, { content: panel.content });
          scheduleCommit(60_000);
          // Don't shrink; only expand on overflow
          maybeExpandOnOverflow();
          ensureScrollPosition();
        });
        textarea.addEventListener('paste', () => setTimeout(() => { maybeExpandOnOverflow(); ensureScrollPosition(); }, 50));

        // Keep textarea synced to panel size changes
        try {
          const ro = new ResizeObserver(() => syncTextareaToContent());
          ro.observe(panelElement);
        } catch {}
        hydrateInitialHeights();
      } else if (panel.type === 'calendar') {
        calendarManager.renderCalendar(panel.id);
      } else if (panel.type === 'external') {
        if (externalManager && typeof externalManager.initializeExternalPanel === 'function') {
          externalManager.initializeExternalPanel(panel.id, panelElement, this);
        }
      } else if (panel.type === 'custom-panel') {
        // Initialize the chat module for custom panels
        const container = panelElement.querySelector(`#chat-wrapper-${panel.id}`);

        // Ensure ChatWidget is loaded
        const initChat = () => {
          if (container && window.ChatWidget) {
            // Create a new chat widget instance
            const chatInstance = new ChatWidget(container, panel.id);
            // Store reference on panel for lifecycle management
            panel.customInstance = chatInstance;

            // For cw panels: clicking anywhere in the chat area should focus the input
            panelElement.addEventListener('click', (e) => {
              if (!panelElement.classList.contains('cw-panel')) return;
              const input = panelElement.querySelector('.cw-textarea');
              if (!input) return;
              // Ignore clicks on native controls or buttons
              if (e.target.closest('textarea, input, button, select, [contenteditable]')) return;
              if (e.target.closest('.cw-nav')) return;
              // Focus the chat input without toggling OS edit mode
              input.focus();
            });

            // (reverted paint/compositing nudge)
          } else if (!window.ChatWidget) {
            // Try again in a moment if ChatWidget isn't loaded yet
            setTimeout(initChat, 100);
          }
        };

        // Initialize immediately or after a small delay
        if (window.ChatWidget) {
          initChat();
        } else {
          setTimeout(initChat, 100);
        }
      } else if (panel.type === 'jobPanel') {
        this.initializeJobPanel(panelElement, panel);
      }
    }

    // ─── JOB PANEL: live actions editing ─────────────────────────────────
    initializeJobPanel(panelElement, panel) {
      const taskId = panel.taskId || panel.id;
      const actionsContainer = panelElement.querySelector(`[data-actions-panel="${panel.id}"]`);
      const actionInput = panelElement.querySelector(`[data-action-input="${panel.id}"]`);
      const statusLight = panelElement.querySelector('.job-status-light');
      const badgeEl = panelElement.querySelector('.job-badge');
      if (!actionsContainer) return;

      // Helper: get current task data from Firestore-synced state
      const getTaskData = () => (window.briizPersistence?.state?.tasks || []).find(t => t.id === taskId);

      // Helper: save updated actions array back to Firestore
      const saveActions = (actions) => {
        if (!window.briizPersistence) return;
        window.briizPersistence.queueFirebaseSave('tasks', taskId, { actions });
        // Also update in-memory state
        const task = getTaskData();
        if (task) task.actions = actions;
      };

      // Render the actions list from task data
      const renderActions = () => {
        const task = getTaskData();
        const actions = (task && Array.isArray(task.actions)) ? task.actions : [];
        const ol = actionsContainer.querySelector('.job-actions-ol');
        if (!ol) return;

        if (actions.length === 0) {
          ol.innerHTML = '<li class="job-action-empty">Awaiting local agent</li>';
        } else {
          // Sort oldest first (by `created` timestamp)
          const sorted = [...actions].sort((a, b) => (a.created || 0) - (b.created || 0));
          ol.innerHTML = sorted.map((action, idx) => `
            <li class="job-action-item ${action.completed ? 'completed' : ''}" data-action-id="${action.id}">
              <button class="job-action-check" title="Toggle complete">${action.completed ? '&#10003;' : '&#9675;'}</button>
              <span class="job-action-title" contenteditable="true" spellcheck="false">${this.escapeJobHtml(action.title || '')}</span>
              <button class="job-action-delete" title="Remove">&times;</button>
            </li>
          `).join('');
        }

        // Update task-level status badge/light based on actions
        if (task) {
          const allDone = actions.length > 0 && actions.every(a => a.completed);
          const taskStatus = task.status || 'running';
          if (statusLight) {
            statusLight.className = 'job-status-light ' + (allDone || taskStatus === 'complete' ? 'green' : 'pink');
          }
          if (badgeEl) {
            if (allDone || taskStatus === 'complete') {
              badgeEl.className = 'job-badge complete';
              badgeEl.textContent = 'COMPLETE';
            } else {
              badgeEl.className = 'job-badge running';
              badgeEl.textContent = 'RUNNING...';
            }
          }
        }

        // Wire up action event listeners
        ol.querySelectorAll('.job-action-item').forEach(li => {
          const actionId = li.dataset.actionId;

          // Toggle complete
          li.querySelector('.job-action-check')?.addEventListener('click', (e) => {
            e.stopPropagation();
            const task = getTaskData();
            if (!task || !Array.isArray(task.actions)) return;
            const updated = task.actions.map(a => {
              if (a.id === actionId) {
                return { ...a, completed: !a.completed, completedAt: !a.completed ? Date.now() : null };
              }
              return a;
            });
            saveActions(updated);
            renderActions();
          });

          // Inline edit title (on blur or Enter)
          const titleSpan = li.querySelector('.job-action-title');
          if (titleSpan) {
            const commitEdit = () => {
              const newTitle = titleSpan.textContent.trim();
              if (!newTitle) return; // don't save empty
              const task = getTaskData();
              if (!task || !Array.isArray(task.actions)) return;
              const updated = task.actions.map(a => {
                if (a.id === actionId && a.title !== newTitle) {
                  return { ...a, title: newTitle };
                }
                return a;
              });
              saveActions(updated);
            };
            titleSpan.addEventListener('blur', commitEdit);
            titleSpan.addEventListener('keydown', (e) => {
              if (e.key === 'Enter') { e.preventDefault(); titleSpan.blur(); }
              if (e.key === 'Escape') { titleSpan.blur(); renderActions(); }
            });
          }

          // Delete action
          li.querySelector('.job-action-delete')?.addEventListener('click', (e) => {
            e.stopPropagation();
            const task = getTaskData();
            if (!task || !Array.isArray(task.actions)) return;
            const updated = task.actions.filter(a => a.id !== actionId);
            saveActions(updated);
            renderActions();
          });
        });
      };

      // Add new action on Enter
      if (actionInput) {
        actionInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && actionInput.value.trim()) {
            e.preventDefault();
            const title = actionInput.value.trim();
            actionInput.value = '';
            const task = getTaskData();
            const actions = (task && Array.isArray(task.actions)) ? [...task.actions] : [];
            actions.push({
              id: `tasks-${Date.now()}`,
              title,
              completed: false,
              completedAt: null,
              priority: 'medium',
              created: Date.now(),
            });
            saveActions(actions);
            renderActions();
          }
        });
      }

      // Initial render
      renderActions();

      // Re-render when Firestore data updates (poll every 2s since onSnapshot updates state in place)
      const pollInterval = setInterval(() => {
        if (!document.contains(panelElement)) { clearInterval(pollInterval); return; }
        renderActions();
      }, 2000);
    }

    escapeJobHtml(str) {
      const el = document.createElement('span');
      el.textContent = str;
      return el.innerHTML;
    }

    updatePanelTitle(panelElement, title) {
      const titleElement = panelElement.querySelector('.panel-title');
      titleElement.textContent = title;

      const id = String(panelElement.dataset.panelId);
      const p = this.panels.find(x => String(x.id) === id);
      if (p) {
        p.title = title;
        this.touchPanel(p);
        this.savePanelsToStorage();
      }
    }

    enterEditMode(panelElement) {
      if (this.editingPanel) {
        this.exitEditMode();
      }

      this.editingPanel = panelElement;
      panelElement.classList.add('editing');
      const contentElement = panelElement.querySelector('.panel-content');
      
      if (contentElement.querySelector('textarea')) {
        const ta = contentElement.querySelector('textarea');
        ta.focus();
        // Scroll so newest text is visible around 60% height
        try {
          const target = Math.max(0, ta.scrollHeight - Math.floor(ta.clientHeight * 0.60));
          ta.scrollTop = target;
        } catch {}
      } else {
        contentElement.contentEditable = true;
        contentElement.focus();
      }

      // No background overrides in edit mode; hue-rotate applies at panel level
    }

    exitEditMode() {
      if (!this.editingPanel) return;

      const contentElement = this.editingPanel.querySelector('.panel-content');
      contentElement.contentEditable = false;
      this.editingPanel.classList.remove('editing');

      // Save content
      const panelId = String(this.editingPanel.dataset.panelId);
      const panel = this.panels.find(p => String(p.id) === panelId);
      if (panel) {
        const textarea = contentElement.querySelector('textarea');
        if (textarea) {
          panel.content = textarea.value;
        } else {
          panel.content = contentElement.textContent;
        }
        console.log('[note] commit', { id: String(panel.id), len: (panel.content||'').length });
        stagePanelPatch(panel.id, { content: panel.content });
        // Commit immediately on blur per your preference
        commitPendingChanges({ onlyId: panel.id });
        if (textarea) {
          textarea.style.border = 'none';
          textarea.style.background = 'none';
          // Outside edit mode, keep scroll at top
          try { textarea.scrollTop = 0; } catch {}
        }
        this.touchPanel(panel);
      }

      // Restore previous dimensions if captured
      if (this.editingPanel.dataset.prevW && this.editingPanel.dataset.prevH) {
        this.editingPanel.style.width = this.editingPanel.dataset.prevW + 'px';
        this.editingPanel.style.height = this.editingPanel.dataset.prevH + 'px';
        delete this.editingPanel.dataset.prevW;
        delete this.editingPanel.dataset.prevH;
      }

      // Restore color background variants if a custom color exists
      try {
        const id = String(this.editingPanel.dataset.panelId);
        const panel = this.panels.find(p => String(p.id) === id);
        if (panel && panel.customColor) {
          this.applyPanelColor(this.editingPanel, panel);
          const body = this.editingPanel.querySelector('.panel-body');
          if (body) body.style.removeProperty('background');
        }
      } catch {}

      this.editingPanel = null;
    }

    makeResizable(el, panel) {
      const handle = el.querySelector('.panel-resize-handle');
      if (!handle) return;
      let startX=0, startY=0, startW=0, startH=0;
      const onDown = (e) => {
        e.preventDefault(); e.stopPropagation();
        const rect = el.getBoundingClientRect();
        startX = e.clientX; startY = e.clientY;
        startW = rect.width; startH = rect.height;
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      };
      const onMove = (e) => {
        e.preventDefault();
        const dw = e.clientX - startX;
        const dh = e.clientY - startY;
        const newW = Math.max(240, startW + dw);
        const newH = Math.max(80, startH + dh);
        el.style.width = newW + 'px';
        el.style.height = newH + 'px';
        // Live sync textarea height in note panels
        try {
          const ta = el.querySelector('.notes-editor');
          const content = el.querySelector('.panel-content');
          if (ta && content) {
            ta.style.height = Math.max(60, content.clientHeight) + 'px';
          }
        } catch {}
      };
      const onUp = () => {
        document.removeEventListener('mousemove', onMove);
        document.removeEventListener('mouseup', onUp);
        // persist
        const id = String(el.dataset.panelId);
        const p = this.panels.find(x => String(x.id) === id) || panel;
        if (p) {
          p.w = el.offsetWidth;
          p.h = el.offsetHeight;
          p.autoHeight = false;
          this.touchPanel(p);
          stagePanelPatch(id, { w: p.w, h: p.h, autoHeight: p.autoHeight });
          scheduleCommit(60_000);
          try { persistence.savePanel(p); } catch {}
          // Final sync textarea height
          try {
            const ta = el.querySelector('.notes-editor');
            const content = el.querySelector('.panel-content');
            if (ta && content) {
              ta.style.height = Math.max(60, content.clientHeight) + 'px';
            }
          } catch {}
        }
      };
      handle.addEventListener('mousedown', onDown);
    }

    attachEditDrawer(panelElement, panel) {
      // avoid duplicates
      if (panelElement.querySelector('.panel-drawer')) return;
      const drawer = document.createElement('div');
      drawer.className = 'panel-drawer';
      drawer.innerHTML = `
        <span style="font-size:.9rem;color:#9ee">Worlds:</span>
        <button class="tag-toggle" data-tag="home">Home</button>
        <button class="tag-toggle" data-tag="school">School</button>
        <button class="tag-toggle" data-tag="music">Music</button>
      `;
      panelElement.appendChild(drawer);
      const syncUI = () => {
        const tags = panel.tags || [];
        drawer.querySelectorAll('.tag-toggle').forEach(btn => {
          if (tags.includes(btn.dataset.tag)) btn.classList.add('active');
          else btn.classList.remove('active');
        });
      };
      drawer.addEventListener('click', (e) => {
        const btn = e.target.closest('.tag-toggle');
        if (!btn) return;
        const t = btn.dataset.tag;
        panel.tags = panel.tags || [];
        if (panel.tags.includes(t)) panel.tags = panel.tags.filter(x => x !== t);
        else panel.tags.push(t);
        // persist and apply filter state
        this.touchPanel(panel);
        stagePanelPatch(panel.id, { tags: panel.tags });
        scheduleCommit(60_000);
        syncUI();
        this.applyWorldFilter();
        // mirror to organizer item if linked
        if (panel.orgId && window.OrganizerStore) {
          const it = OrganizerStore.items?.find(i=>i.id===panel.orgId);
          if (it) { it.tags = [...panel.tags]; OrganizerStore.save?.(); }
        }
      });
      syncUI();
    }

