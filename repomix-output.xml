  /* Panel Settings Backside System */
  .dynamic-panel {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .panel-body {
    transition: transform 0.6s ease;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  .panel-backside {
    position: absolute;
    inset: 0;
    display: none;
    backface-visibility: hidden;
    transform: rotateY(180deg);
    background: linear-gradient(-135deg, #0d2e22bb, #0a2a3abb);
    backdrop-filter: blur(12px);
    border-radius: 16px;
    overflow: hidden;
  }

  .dynamic-panel.panel-flipped {
    position: fixed !important;
    left: 50% !important;
    top: 50% !important;
    transform: translate(-50%, -50%) !important;
    cursor: default !important;
    z-index: 10000 !important;
  }

  .dynamic-panel.panel-flipped .panel-body {
    transform: rotateY(180deg);
    pointer-events: none;
  }

  .dynamic-panel.panel-flipped .panel-backside {
    display: flex;
    transform: rotateY(0deg);
    pointer-events: auto;
  }

