  function normalizeStateShape(input){
    if (!input || typeof input !== 'object') return createEmptyState();
    const normalized = createEmptyState();
    normalized.__ver = input.__ver === SNAP_VER ? SNAP_VER : SNAP_VER;
    normalized.panels = Array.isArray(input.panels) ? input.panels : Object.values(input.panels || {});
    normalized.panelMinStack = Array.isArray(input.panelMinStack) ? input.panelMinStack : [];
    normalized.tasks = Array.isArray(input.tasks) ? input.tasks : [];
    normalized.events = Array.isArray(input.events) ? input.events : [];
    if (Array.isArray(input.organizer)) {
      normalized.organizer = [...input.organizer];
    } else if (input.organizer && typeof input.organizer === 'object') {
      normalized.organizer = Object.values(input.organizer);
    }
    normalized.thoughtstream = Array.isArray(input.thoughtstream) ? input.thoughtstream : [];
    normalized.calendar = input.calendar && typeof input.calendar === 'object' ? input.calendar : {};
    normalized.chatThreads = input.chatThreads && typeof input.chatThreads === 'object' ? input.chatThreads : {};
    normalized.stats = input.stats && typeof input.stats === 'object' ? input.stats : { active: 0, completedToday: 0 };
    normalized.clientTs = typeof input.clientTs === 'number' ? input.clientTs : 0;
    return normalized;
  }

