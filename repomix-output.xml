  function populateOverlayDots(){
    OrganizerStore.load();
    const byDate = new Map();
    const cv = ensureCalView();
    const rangeStart = new Date(cv.y, cv.m, 1);
    const rangeEnd = new Date(cv.y, cv.m + 1, 0);
    const rangeDates = enumerateDates(rangeStart, rangeEnd);
    (state.events || []).forEach(it=>{
      if (it.type !== 'event') return;
      rangeDates.forEach(d => {
        if (eventOccursOnDate(it, d)) {
          const arr = byDate.get(d) || [];
          arr.push(it);
          byDate.set(d, arr);
        }
      });
