                    <label for="userId">User ID:</label>
                    <input type="text" id="userId" placeholder="Enter user ID or use authenticated UID">
                    <button class="btn" id="loadBtn" disabled>Load Collections</button>
                </div>

                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="🔍 Search documents..." disabled>
                </div>

                <div class="filter-controls">
                    <span class="filter-label">Filter by source:</span>
                    <div class="filter-buttons">
                        <button class="filter-btn active" data-filter="all">All</button>
                        <button class="filter-btn" data-filter="shared">Shared</button>
                        <button class="filter-btn" data-filter="local">Local</button>
                        <button class="filter-btn" data-filter="web">Web</button>
                    </div>
                </div>

                <div class="tree-view" id="treeView">
                    <div class="empty-state" style="padding: 20px; font-size: 0.9em;">
                        <p>Login and load to view collections</p>
                    </div>
                </div>
            </div>

            <div class="content-area" id="contentArea">
                <div class="empty-state">
                    <div class="empty-state-icon">📂</div>
                    <h3>Welcome to Firestore Viewer</h3>
                    <p>Login and enter a User ID to view the filesystem structure</p>
                    <p style="margin-top: 10px; font-size: 0.9em; color: #888;">
                        Features: Real-time data loading • Search • Filter • View & Edit documents
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal" id="editModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Edit Document</h2>
                <span class="modal-close" onclick="closeEditModal()">✕</span>
            </div>
            <div id="modalBody">
                <textarea class="json-editor" id="jsonEditor" rows="15"></textarea>
                <button class="btn" onclick="saveDocument()" style="margin-top: 15px;">Save Changes</button>
            </div>
        </div>
    </div>

    <script type="module">
        // Firebase imports
        import { initializeApp, getApp, getApps } from "https://www.gstatic.com/firebasejs/10.12.4/firebase-app.js";
        import {
            getAuth, onAuthStateChanged, signInWithEmailAndPassword, signOut
        } from "https://www.gstatic.com/firebasejs/10.12.4/firebase-auth.js";
        import {
            getFirestore, doc, getDoc, getDocs, setDoc, deleteDoc, collection, query, orderBy, limit, Timestamp
        } from "https://www.gstatic.com/firebasejs/10.12.4/firebase-firestore.js";

        // Firebase configuration
        const firebaseConfig = {
            apiKey: "AIzaSyDibdtqeea1yHqi4ddlZCmAhuq269iK06c",
            authDomain: "briizos.firebaseapp.com",
            projectId: "briizos",
            storageBucket: "briizos.firebasestorage.app",
            messagingSenderId: "719807847926",
            appId: "1:719807847926:web:96ff6b12166b2dec25fbd7",
            measurementId: "G-DCXFC8CS51"
        };

        // Initialize Firebase
        const app = getApps().length ? getApp() : initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // Firestore Schema Definition
        const FIRESTORE_SCHEMA = {
            collections: [
                { name: 'panels', icon: '📋', source: 'shared', description: 'UI panels and notes' },
                { name: 'tasks', icon: '✓', source: 'shared', description: 'Task management' },
                { name: 'events', icon: '📅', source: 'shared', description: 'Calendar events' },
                { name: 'organizer', icon: '📊', source: 'shared', description: 'Organizer items' },
                { name: 'desktopChatMessages', icon: '💬', source: 'local', description: 'Desktop chat messages' },
                { name: 'desktopSessions', icon: '🖥️', source: 'local', description: 'Desktop sessions' },
                { name: 'desktopSelectedFiles', icon: '📁', source: 'local', description: 'Selected files' },
                { name: 'desktopSettings', icon: '⚙️', source: 'local', description: 'Desktop settings' },
                { name: 'desktopLogs', icon: '📝', source: 'local', description: 'Desktop logs' },
                { name: 'desktopRemoteChat', icon: '🌐', source: 'local', description: 'Remote chat' },
                { name: 'app', icon: '⚡', source: 'web', description: 'Web app state' },
                { name: 'snapshots', icon: '📸', source: 'web', description: 'App snapshots' }
            ]
        };

        // State
        let currentUser = null;
        let selectedCollection = null;
        let collectionsData = {};
        let currentFilter = 'all';
        let searchQuery = '';
        let currentEditDoc = null;

        // Auth state handler
        onAuthStateChanged(auth, (user) => {
            const authStatus = document.getElementById('authStatus');
            const loginBtn = document.getElementById('loginBtn');
            const logoutBtn = document.getElementById('logoutBtn');
            const loadBtn = document.getElementById('loadBtn');
            const userIdInput = document.getElementById('userId');

            if (user) {
                authStatus.innerHTML = `<span style="color: #6f6;">✓ ${user.email}</span>`;
                loginBtn.style.display = 'none';
                logoutBtn.style.display = 'block';
                loadBtn.disabled = false;
                userIdInput.value = user.uid;
                document.getElementById('searchInput').disabled = false;
            } else {
                authStatus.innerHTML = '<span>Not authenticated</span>';
                loginBtn.style.display = 'block';
                logoutBtn.style.display = 'none';
                loadBtn.disabled = true;
                document.getElementById('searchInput').disabled = true;
            }
        });

        // Login handler
        document.getElementById('loginBtn').addEventListener('click', async () => {
            const email = document.getElementById('authEmail').value;
            const password = document.getElementById('authPassword').value;
            
            if (!email || !password) {
                showError('Please enter email and password');
                return;
            }

            try {
                await signInWithEmailAndPassword(auth, email, password);
                showSuccess('Logged in successfully!');
            } catch (error) {
                showError(`Login failed: ${error.message}`);
            }
        });

        // Logout handler
        document.getElementById('logoutBtn').addEventListener('click', async () => {
            try {
                await signOut(auth);
                currentUser = null;
                collectionsData = {};
                renderTreeView();
                showWelcomeScreen();
                showSuccess('Logged out successfully!');
            } catch (error) {
                showError(`Logout failed: ${error.message}`);
            }
        });

        // Load button handler
        document.getElementById('loadBtn').addEventListener('click', async () => {
            const userId = document.getElementById('userId').value.trim();
            if (!userId) {
                showError('Please enter a user ID');
                return;
            }

            currentUser = userId;
            await loadAllCollections();
        });

        // Load all collections
        async function loadAllCollections() {
            const contentArea = document.getElementById('contentArea');
            contentArea.innerHTML = '<div class="loading"><div class="spinner"></div><p>Loading collections...</p></div>';

            collectionsData = {};

            for (const collectionDef of FIRESTORE_SCHEMA.collections) {
                try {
                    const collRef = collection(db, 'users', currentUser, collectionDef.name);
                    const snapshot = await getDocs(collRef);
                    
                    const docs = [];
                    snapshot.forEach(doc => {
                        docs.push({ id: doc.id, ...doc.data() });
                    });

                    collectionsData[collectionDef.name] = {
                        ...collectionDef,
                        count: docs.length,
                        documents: docs
                    };
                } catch (error) {
                    console.error(`Error loading ${collectionDef.name}:`, error);
                    collectionsData[collectionDef.name] = {
                        ...collectionDef,
                        count: 0,
                        documents: [],
                        error: error.message
                    };
                }
            }

            renderTreeView();
            contentArea.innerHTML = `
                <div class="empty-state">
                    <div class="empty-state-icon">✓</div>
                    <h3>Collections Loaded for: ${currentUser}</h3>
                    <p>Select a collection from the left sidebar to view its contents</p>
                    <p style="margin-top: 15px; color: #888;">
                        Total collections: ${Object.keys(collectionsData).length}
                    </p>
                </div>
            `;
        }

        // Render tree view
        function renderTreeView() {
            const treeView = document.getElementById('treeView');
            
            if (!currentUser || !Object.keys(collectionsData).length) {
                treeView.innerHTML = '<div class="empty-state" style="padding: 20px; font-size: 0.9em;"><p>No data loaded</p></div>';
                return;
            }

            const filtered = Object.values(collectionsData).filter(col => {
                if (currentFilter === 'all') return true;
                return col.source === currentFilter;
            });

            let html = '';
            filtered.forEach(col => {
                const badge = col.source === 'local' ? 'badge-local' :
                             col.source === 'web' ? 'badge-web' : 'badge-shared';
                
                html += `
                    <div class="tree-node">
                        <div class="tree-item ${selectedCollection?.name === col.name ? 'selected' : ''}"
                             data-action="select-collection" data-col="${escapeHtml(col.name)}">
                            <span class="tree-icon">${col.icon}</span>
                            <span class="tree-label">${escapeHtml(col.name)}</span>
                            <span class="tree-count">${col.count}</span>
                        </div>
                    </div>
                `;
            });

            treeView.innerHTML = html || '<div class="empty-state" style="padding: 20px;"><p>No collections match filter</p></div>';
        }

        // Select collection
        window.selectCollection = async function(collectionName) {
            selectedCollection = collectionsData[collectionName];
            renderTreeView();
            renderCollectionView(selectedCollection);
        };

        // Render collection view
        function renderCollectionView(col) {
            const contentArea = document.getElementById('contentArea');
            const badge = col.source === 'local' ? 'badge-local' :
                         col.source === 'web' ? 'badge-web' : 'badge-shared';

            let docs = col.documents || [];
            
            // Apply search filter
            if (searchQuery) {
                docs = docs.filter(doc => {
                    const searchStr = JSON.stringify(doc).toLowerCase();
                    return searchStr.includes(searchQuery.toLowerCase());
                });
            }

            let html = `
                <div class="content-header">
                    <div class="content-header-left">
                        <div class="content-icon">${col.icon}</div>
                        <div class="content-title">
                            <h2>${col.name} <span class="badge ${badge}">${col.source}</span></h2>
                            <p>${col.description}</p>
                        </div>
                    </div>
                    <button class="refresh-btn" data-action="refresh" data-col="${escapeHtml(col.name)}">🔄 Refresh</button>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-label">Total Documents</div>
                        <div class="stat-value">${col.count}</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Filtered Results</div>
                        <div class="stat-value">${docs.length}</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-label">Collection Path</div>
                        <div class="stat-value" style="font-size: 0.9em;">users/{uid}/${col.name}</div>
                    </div>
                </div>
            `;

            if (col.error) {
                html += `<div class="error">Error loading collection: ${col.error}</div>`;
            }

            if (docs.length === 0) {
                html += `
                    <div class="empty-state">
                        <div class="empty-state-icon">📭</div>
                        <h3>No documents found</h3>
                        <p>${searchQuery ? 'Try a different search query' : 'This collection is empty'}</p>
                    </div>
                `;
            } else {
                html += `<div class="document-list"><h3 style="margin-bottom: 15px; color: #667eea;">📄 Documents (${docs.length})</h3>`;

                docs.forEach(doc => {
                    const safeCol = escapeHtml(col.name);
                    const safeDocId = escapeHtml(doc.id);
                    html += `
                        <div class="document-item">
                            <div class="doc-header">
                                <div class="doc-id">🔑 ${safeDocId}</div>
                                <div class="doc-actions">
                                    <button class="doc-action-btn" data-action="view" data-col="${safeCol}" data-doc="${safeDocId}">👁️ View JSON</button>
                                    <button class="doc-action-btn" data-action="edit" data-col="${safeCol}" data-doc="${safeDocId}">✏️ Edit</button>
                                    <button class="doc-action-btn delete" data-action="delete" data-col="${safeCol}" data-doc="${safeDocId}">🗑️ Delete</button>
                                </div>
                            </div>
                            <div class="field-grid">
                    `;

                    Object.entries(doc).forEach(([key, value]) => {
                        if (key === 'id') return;
                        let displayValue;
                        if (value === null || value === undefined) {
                            displayValue = 'null';
                        } else if (typeof value === 'object') {
                            displayValue = JSON.stringify(value, null, 2);
                        } else if (typeof value === 'string' && value.length > 100) {
                            displayValue = value.substring(0, 100) + '...';
                        } else {
                            displayValue = String(value);
                        }

                        html += `
                            <div class="field">
                                <span class="field-key">${escapeHtml(key)}</span>
                                <span class="field-value">${escapeHtml(displayValue)}</span>
                            </div>
                        `;
                    });

                    html += '</div></div>';
                });

                html += '</div>';
            }

            contentArea.innerHTML = html;
        }

        // Refresh collection
        window.refreshCollection = async function(collectionName) {
            const contentArea = document.getElementById('contentArea');
            contentArea.innerHTML = '<div class="loading"><div class="spinner"></div><p>Refreshing collection...</p></div>';

            try {
                const collRef = collection(db, 'users', currentUser, collectionName);
                const snapshot = await getDocs(collRef);
                
                const docs = [];
                snapshot.forEach(doc => {
                    docs.push({ id: doc.id, ...doc.data() });
                });

                collectionsData[collectionName].documents = docs;
                collectionsData[collectionName].count = docs.length;
                
                selectedCollection = collectionsData[collectionName];
                renderTreeView();
                renderCollectionView(selectedCollection);
                showSuccess('Collection refreshed!');
            } catch (error) {
                showError(`Failed to refresh: ${error.message}`);
            }
        };

        // View document as JSON
        window.viewDocument = function(collectionName, docId) {
            const found = collectionsData[collectionName]?.documents.find(d => d.id === docId);
            if (!found) return;

            const modal = document.getElementById('editModal');
            const modalTitle = document.getElementById('modalTitle');
            const jsonEditor = document.getElementById('jsonEditor');

            modalTitle.textContent = `View Document: ${docId}`;
            jsonEditor.value = JSON.stringify(serializeForEditor(found), null, 2);
            jsonEditor.disabled = true;
            modal.classList.add('active');

            // Hide save button for view mode
            modal.querySelector('.btn').style.display = 'none';
        };

        // Edit document
        window.editDocument = function(collectionName, docId) {
            const found = collectionsData[collectionName]?.documents.find(d => d.id === docId);
            if (!found) return;

            currentEditDoc = { collection: collectionName, id: docId };

            const modal = document.getElementById('editModal');
            const modalTitle = document.getElementById('modalTitle');
            const jsonEditor = document.getElementById('jsonEditor');

            modalTitle.textContent = `Edit Document: ${docId}`;
            jsonEditor.value = JSON.stringify(serializeForEditor(found), null, 2);
            jsonEditor.disabled = false;
            modal.classList.add('active');

            // Show save button for edit mode
            modal.querySelector('.btn').style.display = 'block';
        };

        // Save document
        window.saveDocument = async function() {
            if (!currentEditDoc) return;

            const jsonEditor = document.getElementById('jsonEditor');
            let newData;

            try {
                newData = JSON.parse(jsonEditor.value);
            } catch (error) {
                showError('Invalid JSON format');
                return;
            }

            // Remove 'id' from data if present (it's stored in the document path, not the data)
            // Restore Firestore Timestamps from tagged or raw {seconds, nanoseconds} objects
            const dataToSave = deserializeFromEditor({ ...newData });
            delete dataToSave.id;

            try {
                const docRef = doc(db, 'users', currentUser, currentEditDoc.collection, currentEditDoc.id);
                
                // Use setDoc without merge to completely replace the document
                // This ensures deleted fields are actually removed
                await setDoc(docRef, dataToSave);
                
                console.log(`✓ Document saved to Firestore: users/${currentUser}/${currentEditDoc.collection}/${currentEditDoc.id}`);
                console.log('Data written:', dataToSave);
                
                // Update local cache
                const docIndex = collectionsData[currentEditDoc.collection].documents.findIndex(d => d.id === currentEditDoc.id);
                if (docIndex !== -1) {
                    collectionsData[currentEditDoc.collection].documents[docIndex] = { id: currentEditDoc.id, ...dataToSave };
                }

                closeEditModal();
                renderCollectionView(selectedCollection);
                showSuccess('✓ Document saved to Firestore successfully!');
            } catch (error) {
                console.error('Save error:', error);
                showError(`Failed to save: ${error.message}`);
            }
        };

        // Delete document
        window.deleteDocument = async function(collectionName, docId) {
            if (!confirm(`Are you sure you want to delete document "${docId}"?`)) return;

            try {
                const docRef = doc(db, 'users', currentUser, collectionName, docId);
                await deleteDoc(docRef);
                
                // Update local cache
                collectionsData[collectionName].documents = collectionsData[collectionName].documents.filter(d => d.id !== docId);
                collectionsData[collectionName].count--;

                renderTreeView();
                renderCollectionView(selectedCollection);
                showSuccess('Document deleted successfully!');
            } catch (error) {
                showError(`Failed to delete: ${error.message}`);
            }
        };

        // Close edit modal
        window.closeEditModal = function() {
            document.getElementById('editModal').classList.remove('active');
            currentEditDoc = null;
        };

        // Search handler
        document.getElementById('searchInput').addEventListener('input', (e) => {
            searchQuery = e.target.value;
            if (selectedCollection) {
                renderCollectionView(selectedCollection);
            }
        });

        // Filter handlers
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentFilter = btn.dataset.filter;
                renderTreeView();
            });
        });

        // Utility functions
        // Convert Firestore Timestamp objects to a tagged format for JSON editing
        function serializeForEditor(obj) {
            if (obj === null || obj === undefined) return obj;
            if (obj instanceof Timestamp || (obj && typeof obj.toDate === 'function')) {
                return { __type: 'Timestamp', value: obj.toDate().toISOString() };
            }
            if (Array.isArray(obj)) return obj.map(serializeForEditor);
            if (typeof obj === 'object') {
                const result = {};
                for (const [k, v] of Object.entries(obj)) {
                    result[k] = serializeForEditor(v);
                }
                return result;
            }
            return obj;
        }

        // Convert tagged Timestamp objects back to Firestore Timestamps when saving
        function deserializeFromEditor(obj) {
            if (obj === null || obj === undefined) return obj;
            if (Array.isArray(obj)) return obj.map(deserializeFromEditor);
            if (typeof obj === 'object') {
                if (obj.__type === 'Timestamp' && obj.value) {
                    return Timestamp.fromDate(new Date(obj.value));
                }
                // Also handle raw {seconds, nanoseconds} objects as Timestamps
                if (typeof obj.seconds === 'number' && typeof obj.nanoseconds === 'number' && Object.keys(obj).length === 2) {
                    return new Timestamp(obj.seconds, obj.nanoseconds);
                }
                const result = {};
                for (const [k, v] of Object.entries(obj)) {
                    result[k] = deserializeFromEditor(v);
                }
                return result;
            }
            return obj;
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function showError(message) {
            const contentArea = document.getElementById('contentArea');
            const errorDiv = document.createElement('div');
            errorDiv.className = 'error';
            errorDiv.textContent = message;
            contentArea.insertBefore(errorDiv, contentArea.firstChild);
            setTimeout(() => errorDiv.remove(), 5000);
        }

        function showSuccess(message) {
            const contentArea = document.getElementById('contentArea');
            const successDiv = document.createElement('div');
            successDiv.className = 'success';
            successDiv.textContent = message;
            contentArea.insertBefore(successDiv, contentArea.firstChild);
            setTimeout(() => successDiv.remove(), 3000);
        }

        function showWelcomeScreen() {
            const contentArea = document.getElementById('contentArea');
            contentArea.innerHTML = `
                <div class="empty-state">
                    <div class="empty-state-icon">📂</div>
                    <h3>Welcome to Firestore Viewer</h3>
                    <p>Login and enter a User ID to view the filesystem structure</p>
                    <p style="margin-top: 10px; font-size: 0.9em; color: #888;">
                        Features: Real-time data loading • Search • Filter • View & Edit documents
                    </p>
                </div>
            `;
        }

        // Event delegation for document action buttons
        document.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-action]');
            if (!btn) return;
            const action = btn.dataset.action;
            const colName = btn.dataset.col;
            const docId = btn.dataset.doc;

            switch (action) {
                case 'view':
                    viewDocument(colName, docId);
                    break;
                case 'edit':
                    editDocument(colName, docId);
                    break;
                case 'delete':
                    deleteDocument(colName, docId);
                    break;
                case 'refresh':
                    refreshCollection(colName);
                    break;
                case 'select-collection':
                    selectCollection(colName);
                    break;
            }
        });

        // Close modal on outside click
        document.getElementById('editModal').addEventListener('click', (e) => {
            if (e.target.id === 'editModal') {
                closeEditModal();
            }
        });
    </script>
</body>
</html>
