    height: 100%; /* fill body area */
    width:100%;
    overflow: auto; /* content scrolls within panel */
    outline: none;  
    padding-right:32px;
  }
  .panel-body {
    position: relative;
    height: 100%;
    width: 100%;
    overflow: hidden; /* clip everything except title */
    border-radius: inherit;
  }
  /* Scrollbar styling (best-effort; iframe inner doc may not inherit) */
  .panel-content {
    scrollbar-width: thin; /* Firefox */
    scrollbar-color: #00ffcc rgba(0,0,0,0.2);
  }
  .panel-content::-webkit-scrollbar {
    width: 10px; height: 10px;
  }
  .panel-content::-webkit-scrollbar-thumb {
    background: #00ffcc;
    border-radius: 999px;
    border: 2px solid rgba(0,0,0,0.15);
  }
  .panel-content::-webkit-scrollbar-track {
    background: rgba(0,0,0,0.15);
    border-radius: 999px;
  }
  /* Some browsers may apply these to iframe element scrollbars (not inner doc) */
  .external-frame {
    scrollbar-width: thin;
  filter:brightness(1)saturate(.85);   opacity:.84;
    scrollbar-color: #00ffcc transparent;
  }
  .external-frame::-webkit-scrollbar { width: 10px; height: 10px; }
  .external-frame::-webkit-scrollbar-thumb { background: #00ffcc; border-radius: 999px; }

  .panel-content[contenteditable="true"] {
    border: 1px dashed #00ffcc;
    border-radius: 0.5rem;
    padding: 0.5rem;
    background: rgba(0, 255, 204, 0.1);
  }

