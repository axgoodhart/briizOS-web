  // Calendar Management System
  class CalendarManager {
    constructor() {
      this.events = state.events;
    }

    refreshFromState() {
      try { renderCalendarOverlay(); } catch {}
    }

    renderCalendar(panelId) {
      const calendarGrid = document.getElementById(`calendar-grid-${panelId}`);
      if (!calendarGrid) return;
      
      const today = new Date();
      const currentMonth = today.getMonth();
      const currentYear = today.getFullYear();
      
      calendarGrid.innerHTML = '';
      
      // Create day headers
      const dayHeaders = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      dayHeaders.forEach(day => {
        const dayHeader = document.createElement('div');
        dayHeader.style.fontWeight = 'bold';
        dayHeader.style.textAlign = 'center';
        dayHeader.style.padding = '5px';
        dayHeader.style.color = '#00ffcc';
        dayHeader.style.fontSize = '0.9rem';
        dayHeader.textContent = day;
        calendarGrid.appendChild(dayHeader);
      });
      
      // Create calendar days
      const firstDay = new Date(currentYear, currentMonth, 1).getDay();
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      
      // Empty cells for days before the first day of the month
      for (let i = 0; i < firstDay; i++) {
        const emptyDay = document.createElement('div');
        emptyDay.className = 'calendar-day';
        emptyDay.style.opacity = '0.3';
        calendarGrid.appendChild(emptyDay);
      }
      
      // Days of the month
      for (let day = 1; day <= daysInMonth; day++) {
        const dayElement = document.createElement('div');
        dayElement.className = 'calendar-day';
        
        if (day === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear()) {
          dayElement.classList.add('today');
        }
        
        dayElement.innerHTML = `<div style="font-weight: bold; margin-bottom: 5px;">${day}</div>`;
        
        dayElement.addEventListener('click', () => {
          this.addEvent(currentYear, currentMonth, day);
        });
        
        calendarGrid.appendChild(dayElement);
      }
    }

    addEvent(year, month, day) {
      const eventText = prompt('Enter event description:');
      if (eventText) {
        const now = Date.now();
        const event = {
          id: `event-${now}`,
          date: new Date(year, month, day),
          text: eventText,
          created: now,
          createdAt: now,
          updatedAt: now
        };
        
        this.events.push(event);
        this.saveEventsToStorage();
        
        const iso = yyyyMMdd(event.date);
        try {
          OrganizerStore.create({ name: eventText, type: 'event', scheduledDate: iso, due: iso, dateMode: 'event', dateValue: iso, source: { mode: 'calendar' } });
        } catch (err) {
          console.warn('Unable to sync event into organizer', err);
        }

        // Add task to task manager as well
        taskManager.createTask(`${eventText} (${event.date.toLocaleDateString()})`, 'medium', event.date.toISOString().split('T')[0]);
      }
    }

    async saveEventsToStorage() {
      try {
        for (const ev of this.events) {
          await persistence.saveEvent(ev);
        }
      } catch {}
      return Promise.resolve();
    }
  }

